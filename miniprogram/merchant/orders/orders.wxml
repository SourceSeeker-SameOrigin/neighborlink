<view class="page">
  <view class="page-masthead"><image class="masthead-icon" src="/assets/icons/shop.png"/><view class="masthead-copy"><view class="page-title">商家预约订单</view><view class="masthead-subtitle">管理服务，回应邻里所需</view></view></view>
  <view class="muted">完成服务后需上传 1—3 张现场照片；住户确认后会进入人工周结。</view>
  <view wx:if="{{error && !pageError}}" class="error">{{error}}<button bindtap="retry" disabled="{{loading || busy}}">重新加载</button></view>
  <view wx:for="{{list}}" wx:key="_id" class="card">
    <view class="section-title">{{item.serviceName}} · {{item.statusText}}</view>
    <view>订单号：{{item.orderNo}}</view>
    <view>{{item.address.buildingName}} {{item.address.unit}} {{item.address.room}}</view>
    <view>住户需求：{{item.note || '无'}}</view>
    <view>金额：¥{{item.amountText}}</view>
    <view wx:if="{{item.quote}}">报价：¥{{item.quoteAmountText}} · {{item.quote.detail}}</view>
    <button wx:if="{{item.featureEnabled && item.status === 'pending_quote'}}" data-id="{{item._id}}" bindtap="chooseQuote" disabled="{{!ready || loading || busy}}">填写报价</button>
    <view wx:if="{{item.featureEnabled && quoteId === item._id}}">
      <input class="ui-input" type="digit" placeholder="报价（元）" data-field="quoteAmount" value="{{quoteAmount}}" bindinput="input" disabled="{{!ready || loading || busy}}"/>
      <input class="ui-input" placeholder="报价说明" data-field="quoteDetail" value="{{quoteDetail}}" bindinput="input" disabled="{{!ready || loading || busy}}"/>
      <button type="primary" bindtap="quote" loading="{{busy}}" disabled="{{!ready || loading || busy}}">提交报价并发起支付</button>
    </view>
    <button wx:if="{{item.featureEnabled && item.status === 'paid'}}" data-id="{{item._id}}" data-action="accept" bindtap="transition" disabled="{{!ready || loading || busy}}">接单</button>
    <button wx:if="{{item.featureEnabled && item.status === 'accepted'}}" data-id="{{item._id}}" data-action="start" bindtap="transition" disabled="{{!ready || loading || busy}}">开始服务</button>
    <button wx:if="{{item.featureEnabled && item.status === 'in_service'}}" data-id="{{item._id}}" bindtap="complete" disabled="{{!ready || loading || busy}}">拍照并提交完成</button>
  </view>
  <view wx:if="{{loading}}">正在加载…</view>
  <view wx:elif="{{ready && !list.length}}" class="card">暂无预约订单</view>
  <view wx:if="{{pageError}}" class="error">{{error}}<button bindtap="retry" disabled="{{loading || busy}}">重试加载更多</button></view>
  <button wx:if="{{hasMore && !pageError}}" bindtap="more" disabled="{{!ready || loading || busy}}">加载更多</button>
  <view wx:if="{{ready && list.length && !hasMore}}" class="muted list-end">已显示全部预约订单</view>
</view>
