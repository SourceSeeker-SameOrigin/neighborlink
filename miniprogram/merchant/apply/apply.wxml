<view class="page">
<view class="page-masthead">
<image class="masthead-icon" src="/assets/icons/shop.png"/>
<view class="masthead-copy">
<view class="page-title">商家入驻申请</view>
<view class="masthead-subtitle">管理服务，回应邻里所需</view>
</view>
</view>
<view class="card">审核通过后，商家详情会公示营业执照名称和统一社会信用代码。</view>
<view class="card">
<view class="field">
<view class="label">商家名称</view>
<input disabled="{{!ready || loading || busy || uploading}}" class="ui-input" placeholder="商家名称" data-field="name" value="{{name}}" bindinput="input"/>
</view>
<picker disabled="{{!ready || loading || busy || uploading}}" range="{{categories}}" value="{{categoryIndex}}" bindchange="chooseCategory">
<view class="picker">类别：{{categories[categoryIndex]}}</view>
</picker>
<view class="field">
<view class="label">营业执照名称</view>
<input disabled="{{!ready || loading || busy || uploading}}" class="ui-input" placeholder="营业执照名称" data-field="licenseName" value="{{licenseName}}" bindinput="input"/>
</view>
<view class="field">
<view class="label">统一社会信用代码（18位）</view>
<input disabled="{{!ready || loading || busy || uploading}}" class="ui-input" placeholder="统一社会信用代码（18 位）" data-field="creditCode" value="{{creditCode}}" bindinput="input"/>
</view>
<button loading="{{uploading}}" bindtap="upload" disabled="{{!ready || loading || busy || uploading}}">{{licenseFileId ? '已上传营业执照，点击重选' : '拍摄/上传营业执照'}}</button>
<view class="field">
<view class="label">联系人</view>
<input disabled="{{!ready || loading || busy || uploading}}" class="ui-input" placeholder="联系人" data-field="contactName" value="{{contactName}}" bindinput="input"/>
</view>
<view class="field">
<view class="label">联系电话</view>
<input disabled="{{!ready || loading || busy || uploading}}" class="ui-input" type="number" placeholder="联系电话" data-field="phone" value="{{phone}}" bindinput="input"/>
</view>
<view wx:if="{{ready && existing}}" class="muted">当前状态：{{merchantStatusNames[existing.status] || '状态待确认'}} {{existing.reviewNote}}</view>
</view>
<view wx:if="{{error}}" class="error">{{error}}<button wx:if="{{loadError}}" bindtap="load" disabled="{{loading || busy || uploading}}">重新加载</button></view>
<button type="primary" loading="{{busy}}" disabled="{{!ready || loading || busy || uploading}}" bindtap="submit">提交审核</button>
</view>
