<view class="page"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/recycle.png"/><view class="masthead-copy"><view class="page-title">预约上门回收</view><view class="masthead-subtitle">分类回收，绿色生活</view></view></view><view wx:if="{{createdOrderId}}" class="card">
<view class="section-title">预约已创建</view>
<view class="muted">请前往已有订单查看预约状态，无需重复提交。</view>
<view wx:if="{{navigationError}}" class="error">{{navigationError}}</view>
<button class="ui-button" bindtap="openCreatedOrder" loading="{{navigating}}" disabled="{{busy || navigating}}">前往已有订单</button>
</view>
<block wx:else>
<view class="card muted">服务免费；服务员称重后按小区标准发放环保积分。回收类别、单价和合作企业由小区配置。</view><view class="card"><view class="section-title">选择回收类别</view><view class="choices"><button wx:for="{{categories}}" wx:key="code" data-code="{{item.code}}" bindtap="category" disabled="{{loading || busy}}" class="ui-button {{item.selected ? 'selected' : ''}}">{{item.name}}</button></view><textarea disabled="{{loading || busy}}" maxlength="200" placeholder="补充说明（选填）" bindinput="note" value="{{note}}"/><view wx:if="{{slots.length}}" class="field"><text class="label">预约时段</text><picker disabled="{{loading || busy}}" range="{{slots}}" range-key="start" value="{{slotIndex}}" bindchange="selectSlot"><view class="picker">{{slots[slotIndex].date}} {{slots[slotIndex].start}}–{{slots[slotIndex].end}}</view></picker></view></view><view wx:if="{{recoveryHint}}" class="card muted">{{recoveryHint}}</view><view wx:if="{{error}}" class="error">{{error}}<button class="ui-button" bindtap="load" disabled="{{loading || busy}}">{{lookupError ? '重试核对原预约' : '重新加载'}}</button></view><button wx:if="{{recoveryHint && !lookupError}}" class="ui-button" bindtap="startNewRequest" disabled="{{busy || loading}}">放弃原编号，开始新预约</button><button class="ui-button" type="primary" bindtap="create" disabled="{{busy || loading || quoting || !pricing || lookupError}}" loading="{{busy}}">{{recoveryHint ? '确认并用原编号提交' : '提交免费预约'}}</button>
</block></view><privacy-popup/>
