<view wx:if="{{missingRecord}}" class="page"><view class="card"><view class="section-title">缺少批次编号</view><view class="muted">请从配送工作台选择记录后重新进入。</view><navigator url="/station/worker/worker" open-type="redirect"><button class="ui-button">前往配送工作台</button></navigator></view></view>
<block wx:else>
<view class="page"><empty-state wx:if="{{loading}}" message="正在加载…"/><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="load"/><block wx:if="{{batch}}"><view class="card"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/express.png"/><view class="masthead-copy"><view class="page-title">批次配送</view><view class="masthead-subtitle">送到门口，每一户都记清</view></view></view><view>待配送 {{batch.pendingCount}} 户 · 已送达 {{batch.deliveredCount}} 户 · 授权撤回跳过 {{batch.skippedCount}}</view></view><button wx:if="{{!batch.startedAt && batch.status === 'assigned'}}" type="primary" disabled="{{busy}}" bindtap="start">开始配送</button><view class="card" wx:for="{{batch.items}}" wx:key="_id"><view class="section-title">{{item.buildingName}} {{item.unit}} {{item.room}}</view><view wx:if="{{item.status === 'delivered'}}">已送达 · {{item.atText}}</view><view wx:elif="{{item.status === 'failed'}}">未送达 · {{item.failReason || '无说明'}}</view><view wx:elif="{{item.status === 'skipped'}}" class="error">已跳过 · {{item.failReason}}</view><view wx:elif="{{batch.startedAt}}"><button data-id="{{item._id}}" disabled="{{busy}}" bindtap="delivered">拍照并登记送达</button><button data-id="{{item._id}}" disabled="{{busy}}" bindtap="failed">标记未送达</button></view></view></block></view>
<privacy-popup />

</block>
