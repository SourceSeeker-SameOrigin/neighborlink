<view class="page"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/express.png"/><view class="masthead-copy"><view class="page-title">批次进度</view><view class="masthead-subtitle">送到门口，每一户都记清</view></view></view><navigator class="card" url="/station/create/create"><view class="section-title">创建送上门批次</view><view class="muted">只纳入明确同意送上门的住户 ›</view></navigator><view class="card"><view class="field"><text class="label">对账月份</text><picker mode="date" fields="month" value="{{month}}" bindchange="monthChange" disabled="{{exporting}}"><view class="picker">{{month}}</view></picker></view><button type="primary" loading="{{exporting}}" disabled="{{!ready || loading || exporting}}" bindtap="exportStatement">导出月度对账CSV</button></view><empty-state wx:if="{{error}}" message="{{error}}" retry="{{loadError}}" bind:retry="retry"/><view class="card" wx:for="{{batches}}" wx:key="_id"><view class="section-title">批次 {{item._id}} · {{item.status === 'open' ? '待接单' : item.status === 'assigned' ? '配送中' : '已完成'}}</view><view>创建时间 {{item.createdText}}</view><view>{{item.itemCount}} 户 · 已送达 {{item.deliveredCount}} · 未送达 {{item.failedCount}} · 授权撤回跳过 {{item.skippedCount}}</view></view><empty-state wx:if="{{loading}}" message="正在加载批次…"/><empty-state wx:elif="{{!error && !batches.length}}" message="当前没有批次"/></view>
<privacy-popup />
