<view class="page"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/idle.png"/><view class="masthead-copy"><view class="page-title">担保交易订单</view><view class="masthead-subtitle">闲置流转，物尽其用</view></view></view><navigator class="card menu-row" url="/idle/income/income"><image class="menu-icon" src="/assets/icons/orders.png"/><text class="menu-copy">卖家收入与结算</text><text class="chevron">›</text></navigator><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view wx:for="{{list}}" wx:key="_id" class="card" data-id="{{item._id}}" bindtap="open"><view class="section-title">{{item.title}}</view><view>¥{{item.priceText}} · {{item.statusText}}</view><view class="muted">{{item.timeText}}</view></view><view wx:if="{{loading}}" class="muted">正在加载…</view><view wx:elif="{{!list.length && !error}}" class="muted">暂无担保交易订单</view><view wx:if="{{moreError}}" class="error">{{moreError}}</view><button wx:if="{{hasMore}}" disabled="{{paging}}" loading="{{paging}}" bindtap="more">{{moreError ? '重试加载更多' : '加载更多订单'}}</button></view>
