<view wx:if="{{missingRecord}}" class="page"><view class="card"><view class="section-title">缺少商家编号</view><view class="muted">请从商家列表选择记录后重新进入。</view><navigator url="/shops/list/list" open-type="redirect"><button class="ui-button">前往商家列表</button></navigator></view></view>
<block wx:else>
<view class="page"><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><block wx:if="{{merchant}}"><view class="card"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/shop.png"/><view class="masthead-copy"><view class="page-title">{{merchant.name}}</view><view class="masthead-subtitle">发现身边的生活服务</view></view></view><view>营业执照名称：{{merchant.licenseInfo.name}}</view><view>统一社会信用代码：{{merchant.licenseInfo.creditCode}}</view><view>评分：{{merchant.ratingText}}</view></view><view class="section-title">可预约服务</view><view wx:for="{{list}}" wx:key="_id" class="card"><view class="section-title">{{item.title}}</view><view>{{item.desc}}</view><view wx:if="{{item.priceType === 'fixed'}}">固定价：{{item.priceText}} / {{item.unit}}</view><view wx:else>预约后商家报价</view><button type="primary" data-id="{{item._id}}" bindtap="book">预约</button></view><view wx:if="{{!list.length}}" class="card">暂无可预约服务</view></block><view wx:if="{{hasMore && !loading}}" class="card"><view wx:if="{{moreError}}" class="error">{{moreError}}</view><button class="ui-button" bindtap="more">{{moreError ? '重试本页' : '加载更多'}}</button></view><view wx:if="{{loading}}">正在加载…</view><view wx:if="{{reportError}}" class="error">{{reportError}}</view><button wx:if="{{merchant}}" class="ui-button" bindtap="reportContent">举报商家</button></view>

</block>
