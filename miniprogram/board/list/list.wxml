<view class="page">
  <view class="page-masthead"><image class="masthead-icon" src="/assets/icons/board.png"/><view class="masthead-copy"><view class="page-title">需求广场</view><view class="masthead-subtitle">邻里互助，让小事有回应</view></view></view>
  <view wx:if="{{needsBinding && !loading && !error}}" class="card"><view class="section-title">请先绑定小区门牌</view><view class="muted">完善门牌后，可查看本小区已开放的邻里需求。</view><button class="ui-button" type="primary" bindtap="bindAddress">去绑定门牌</button></view>
  <view wx:if="{{!needsBinding}}" class="tabs"><button class="ui-button" wx:for="{{types}}" wx:key="code" type="{{type === item.code ? 'primary' : 'default'}}" data-type="{{item.code}}" bindtap="chooseType">{{item.label}}</button></view>
  <view wx:if="{{federationEnabled && type !== 'task'}}" class="tabs"><button class="ui-button" data-scope="community" type="{{scope === 'community' ? 'primary' : 'default'}}" bindtap="chooseScope">本小区</button><button class="ui-button" data-scope="federation" type="{{scope === 'federation' ? 'primary' : 'default'}}" bindtap="chooseScope">联合社区</button></view>
  <view wx:if="{{adError}}" class="muted">{{adError}}<button bindtap="retryAds">重试推荐内容</button></view><view wx:for="{{ads}}" wx:key="_id" class="community-ad" data-id="{{item._id}}" bindtap="openAd"><private-media media-class="community-ad-image" src="{{item.imageFileId}}" mode="aspectFill" data-id="{{item._id}}" bindload="recordAd"/><text class="community-ad-label">广告</text><view class="community-ad-title">{{item.title}}</view></view><view wx:if="{{error}}" class="error">{{error}}<button class="ui-button" bindtap="retry">重试</button></view>
  <view wx:for="{{posts}}" wx:key="_id" class="card" data-id="{{item._id}}" bindtap="open"><view wx:if="{{item.sourceCommunityName}}" class="muted">来自 {{item.sourceCommunityName}}</view><view class="section-title">{{item.title}}</view><view>{{item.content}}</view><view wx:if="{{item.type === 'task'}}">悬赏 ¥{{item.rewardText}} · {{item.slotText}} · {{item.needEnterHome ? '需进家' : '不需进家'}}</view><view wx:if="{{item.carry}}">{{item.carry.destination}} · {{item.carry.destinationType === 'overseas' ? '境外' : '境内'}}</view><view class="muted">{{item.typeText}} · {{item.timeText}} · {{item.commentsCount}} 条评论</view></view>
  <view wx:if="{{loading}}">正在加载…</view><view wx:elif="{{!needsBinding && !posts.length && !error && !hasMore}}">暂无内容</view>
  <button wx:if="{{!needsBinding && !loading && !error}}" class="ui-button" type="primary" bindtap="create">发布{{type === 'task' ? '悬赏' : type === 'carry' ? '帮带' : '求助'}}</button><button class="ui-button" wx:if="{{hasMore && !loading && !error}}" bindtap="more">加载更多</button>
</view>
