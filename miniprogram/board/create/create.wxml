<view class="page">
  <view class="page-masthead"><image class="masthead-icon" src="/assets/icons/board.png"/><view class="masthead-copy"><view class="page-title">发布{{type === 'task' ? '悬赏任务' : type === 'carry' ? '出行帮带' : '求助'}}</view><view class="masthead-subtitle">邻里互助，让小事有回应</view></view></view>
  <view wx:if="{{error}}" class="error">{{error}}<button wx:if="{{loadError}}" bindtap="load" disabled="{{loading}}">重新加载</button></view>
  <view wx:if="{{dateError}}" class="error">{{dateError}}</view>
  <view wx:if="{{recoveryHint}}" class="card muted">{{recoveryHint}}
    <button wx:if="{{createdPostId}}" bindtap="openCreated">前往已有记录</button>
    <button wx:if="{{lookupError}}" bindtap="load" disabled="{{loading}}">重试核对原发布</button>
    <button wx:if="{{!lookupError}}" bindtap="startNewRequest" disabled="{{busy || loading}}">放弃原编号，开始新发布</button>
  </view>
  <view class="card">
  <view class="field"><view class="label">标题</view><input class="ui-input" placeholder="标题" maxlength="100" value="{{title}}" data-field="title" bindinput="field"/></view>
  <view class="field"><view class="label">具体情况</view><textarea class="ui-textarea" placeholder="说说具体情况" maxlength="2000" value="{{content}}" data-field="content" bindinput="field"/></view>
  <picker wx:if="{{federationEnabled && type !== 'task'}}" range="{{scopeOptions}}" value="{{scope === 'community' ? 0 : 1}}" bindchange="scope"><view class="picker">{{scope === 'community' ? '本小区' : '联合社区'}}</view></picker>
  <block wx:if="{{type === 'task'}}">
    <view class="field"><view class="label">悬赏金额（元，至少3.00元）</view><input class="ui-input" type="digit" placeholder="悬赏金额（元，至少 3.00）" value="{{rewardYuan}}" data-field="rewardYuan" bindinput="field" /></view>
    <picker mode="date" value="{{slotDate}}" start="{{today}}" data-field="slotDate" bindchange="choose"><view class="picker">服务日期 {{slotDate}}</view></picker>
    <picker range="{{slotOptions}}" range-key="label" value="{{slotIndex}}" data-field="slotIndex" bindchange="choose"><view class="picker">值班时段 {{slotLabel}}</view></picker>
    <checkbox-group bindchange="toggleEnterHome"><label><checkbox value="yes"/>服务需要进入家中（需认证服务员）</label></checkbox-group>
    <view class="notice">发布后需先支付悬赏金；支付成功后任务才会公开。</view>
  </block>
  <block wx:if="{{type === 'carry'}}">
    <picker range="{{directionOptions}}" value="{{direction === 'request' ? 0 : 1}}" bindchange="choose" data-field="direction"><view class="picker">{{direction === 'request' ? '求帮带' : '我能帮带'}}</view></picker>
    <view class="field"><view class="label">目的地</view><input class="ui-input" placeholder="目的地" maxlength="100" value="{{destination}}" data-field="destination" bindinput="field"/></view>
    <picker range="{{destinationTypes}}" value="{{destinationType === 'domestic' ? 0 : 1}}" bindchange="choose" data-field="destinationType"><view class="picker">{{destinationType === 'domestic' ? '境内' : '境外'}}</view></picker>
    <picker mode="date" value="{{departDate}}" data-field="departDate" bindchange="choose"><view class="picker">出发日期 {{departDate}}</view></picker>
    <picker mode="time" value="{{departTime}}" data-field="departTime" bindchange="choose"><view class="picker">出发时间 {{departTime}}</view></picker>
    <picker mode="date" value="{{returnDate}}" data-field="returnDate" bindchange="choose"><view class="picker">返程日期 {{returnDate}}</view></picker>
    <picker mode="time" value="{{returnTime}}" data-field="returnTime" bindchange="choose"><view class="picker">返程时间 {{returnTime}}</view></picker>
    <view wx:if="{{destinationType === 'overseas'}}" class="notice"><view>仅限个人自用、不加价、按海关规定如实申报；居民旅客境外获取物品免税额度为 5000 元，超出部分需申报纳税。</view><checkbox-group bindchange="agree"><label><checkbox value="agree"/>我已阅读并同意</label></checkbox-group></view>
  </block>
  </view>
  <view wx:if="{{images.length}}">已选择 {{images.length}} 张图片</view><button bindtap="photos" disabled="{{!ready || loading || busy}}">添加图片（最多 3 张）</button>
  <button type="primary" bindtap="submit" loading="{{busy}}" disabled="{{!ready || loading || busy || lookupError || (dateError && !createdPostId)}}">{{createdPostId ? '前往已有记录' : recoveryHint ? '确认并用原编号发布' : type === 'task' ? '发布并支付悬赏' : '发布'}}</button>
</view>
