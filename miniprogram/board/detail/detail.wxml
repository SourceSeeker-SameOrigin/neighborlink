<view wx:if="{{missingRecord}}" class="page"><view class="card"><view class="section-title">缺少需求编号</view><view class="muted">请从需求广场选择记录后重新进入。</view><navigator url="/board/list/list" open-type="redirect"><button class="ui-button">前往需求广场</button></navigator></view></view>
<block wx:else>
<view class="page">
  <view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view>
  <block wx:if="{{post}}">
    <view class="card"><view wx:if="{{post.sourceCommunityName}}" class="muted">来自 {{post.sourceCommunityName}}</view><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/board.png"/><view class="masthead-copy"><view class="page-title">{{post.title}}</view><view class="masthead-subtitle">邻里互助，让小事有回应</view></view></view><view>{{post.content}}</view><view wx:if="{{post.type === 'task'}}" class="notice">悬赏 ¥{{post.rewardText}} · 服务时间 {{post.slotText}} · {{post.needEnterHome ? '需进入家中（限认证服务员）' : '无需进入家中'}}</view>
      <view wx:if="{{post.carry}}">{{post.carry.direction === 'request' ? '求帮带' : '我能帮带'}} · {{post.carry.destination}} · {{post.carry.destinationType === 'overseas' ? '境外' : '境内'}}</view>
      <view wx:if="{{post.carry}}">出发 {{post.departText}}<text wx:if="{{post.returnText}}"> · 返程 {{post.returnText}}</text></view>
      <view wx:if="{{post.carry && post.carry.destinationType === 'overseas'}}" class="notice">仅限个人自用、不加价、按海关规定如实申报；居民旅客境外获取物品免税额度为 5000 元，超出部分需申报纳税。</view>
      <private-media wx:for="{{post.images}}" wx:key="*this" media-class="photo" src="{{item}}" data-url="{{item}}" bindtap="preview" mode="aspectFill"/>
      <view class="muted">{{post.timeText}} · {{post.statusText}}</view>
      <button wx:if="{{post.isAuthor && post.type === 'task' && post.status === 'pending_pay'}}" type="primary" bindtap="continuePayment">继续支付悬赏</button><button wx:if="{{post.isAuthor && post.status === 'open'}}" bindtap="close">关闭</button><button wx:elif="{{!post.isAuthor}}" bindtap="report">举报</button>
    </view>
    <view class="section-title">评论 {{post.commentsCount}}</view>
    <view wx:for="{{comments}}" wx:key="_id" class="card"><view>{{item.content}}</view><view class="muted">{{item.timeText}}</view><button wx:if="{{!item.mine}}" data-id="{{item._id}}" bindtap="reportComment">举报</button></view>
    <view wx:if="{{commentsError}}" class="error">{{commentsError}}</view>
    <button wx:if="{{commentsHasMore}}" bindtap="moreComments" loading="{{commentsPaging}}" disabled="{{commentsPaging}}">{{commentsError ? '重试加载评论' : '加载更多评论'}}</button>
    <view wx:if="{{post.status === 'open' || commentRecovery}}" class="card">
      <view wx:if="{{commentRecoveryHint}}" class="notice">{{commentRecoveryHint}}</view>
      <button wx:if="{{commentRecovery === 'lookup'}}" bindtap="retryOriginalComment">重试核对原评论</button>
      <button wx:if="{{commentRecovery === 'found'}}" bindtap="startNewComment">开始新评论</button>
      <block wx:if="{{post.status === 'open' && commentRecovery !== 'found' && commentRecovery !== 'lookup'}}">
        <textarea value="{{commentText}}" maxlength="500" placeholder="写条评论" bindinput="input"/>
        <button type="primary" bindtap="comment" loading="{{busy}}" disabled="{{busy}}">{{commentRecovery === 'confirm' ? '确认并重试原评论' : '发送评论'}}</button>
      </block>
    </view>
  </block>
  <view wx:if="{{loading}}">正在加载…</view>
</view>

</block>
