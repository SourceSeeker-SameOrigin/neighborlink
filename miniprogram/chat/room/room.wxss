.room{display:flex;flex-direction:column;height:100vh;box-sizing:border-box}.messages{flex:1;min-height:0;padding:20rpx}.message-row{display:flex;margin:16rpx 0;justify-content:flex-start}.message-row.mine{justify-content:flex-end}.bubble{max-width:78%;padding:18rpx 22rpx;border-radius:18rpx;background:#fff;word-break:break-word}.mine .bubble{background:#E6F0E0}.time{font-size:32rpx;color:#687466;margin-top:8rpx}.message-image{max-width:420rpx;border-radius:12rpx}.composer{display:flex;align-items:flex-end;gap:12rpx;padding:14rpx;background:#fff}.composer .ui-textarea{flex:1;max-height:180rpx;padding:12rpx;background:#F5F6F0;border-radius:10rpx}.notice{text-align:center;padding:24rpx}
.room{padding-bottom:env(safe-area-inset-bottom)}.room .page-masthead{flex-shrink:0;padding:8rpx 0 18rpx;margin:0}.room .masthead-icon{width:64rpx;height:64rpx;padding:12rpx;border-radius:18rpx}.room .page-title{font-size:36rpx}.room .masthead-subtitle{display:none}.messages{box-sizing:border-box;border-top:1rpx solid #E3E7DB}.bubble{border:1rpx solid #E3E7DB;border-radius:22rpx;line-height:1.65}.composer{box-sizing:border-box;flex-shrink:0;border-top:1rpx solid #E3E7DB;padding-bottom:20rpx;border-radius:20rpx 20rpx 0 0}.composer .ui-textarea{min-width:0;min-height:88rpx;font-size:32rpx}.composer .ui-button{flex-shrink:0;padding:16rpx;font-size:32rpx;min-height:88rpx}
