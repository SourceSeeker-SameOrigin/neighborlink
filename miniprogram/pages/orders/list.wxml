<view class="page"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/orders.png"/><view class="masthead-copy"><view class="page-title">我的订单</view><view class="masthead-subtitle">邻里互助，安心到家</view></view></view><view class="tabs"><button class="ui-button" wx:for="{{groups}}" wx:key="code" type="{{group === item.code ? 'primary' : 'default'}}" data-group="{{item.code}}" bindtap="groupChange">{{item.name}}</button></view><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="retry"/><order-card wx:for="{{orders}}" wx:key="_id" order="{{item}}"/><empty-state wx:if="{{loading}}" message="正在加载订单…"/><empty-state wx:elif="{{!error && !orders.length}}" message="这里还没有订单"/><button class="ui-button" wx:if="{{hasMore && orders.length && !loading}}" bindtap="retry">加载更多</button></view>
