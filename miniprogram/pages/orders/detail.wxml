<view wx:if="{{missingRecord}}" class="page"><view class="card"><view class="section-title">缺少订单编号</view><view class="muted">请从我的订单选择记录后重新进入。</view><navigator url="/pages/orders/list" open-type="switchTab"><button class="ui-button">前往我的订单</button></navigator></view></view>
<block wx:else>
<view class="page">
  <empty-state wx:if="{{loading}}" message="正在加载订单…"/>
  <empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="load"/>
  <block wx:if="{{order}}"><view wx:if="{{order.featureEnabled === false}}" class="card">该服务暂未开放，已有订单仍可查看并按原规则申请取消或退款。</view>
    <view class="card">
      <view class="page-masthead"><image class="masthead-icon" src="/assets/icons/orders.png"/><view class="masthead-copy"><view class="page-title">{{order.statusText}}</view><view class="masthead-subtitle">邻里互助，安心到家</view></view></view>
      <view wx:if="{{order.status === 'paid'}}">服务员接单后会给您打电话</view>
      <view>{{order.serviceName}} · <text wx:if="{{order.status === 'pending_quote'}}">待商家报价</text><text wx:else>¥{{amount}}</text></view>
      <button class="ui-button" wx:if="{{order.canChat}}" bindtap="openChat">站内聊天<text wx:if="{{unread}}"> · {{unread}} 条未读</text></button>
      <view wx:if="{{order.pricing.couponDiscount}}">优惠券抵扣 ¥{{couponDiscountText}}</view>
      <view wx:if="{{pointsRedeemed}}">环保积分抵扣 {{pointsRedeemed}} 分</view>
      <view class="muted">订单号：{{order.orderNo}}</view>
    </view>

    <view class="card" wx:if="{{order.serviceCode === 'visit' && !order.visitReport && (order.status === 'paid' || order.status === 'accepted' || order.status === 'in_service')}}">
      <view class="section-title">探访报告提醒</view>
      <view class="muted">每次探访单独授权一次通知；未授权时，报告仍会显示在此订单详情。</view>
      <button class="ui-button" wx:if="{{!order.visitReportNotifyAuthorized}}" bindtap="subscribeVisitReport" disabled="{{busy}}">订阅本次探访报告</button>
      <view wx:else>已订阅本次报告提醒</view>
    </view>
    <view class="card" wx:if="{{order.serviceCode === 'vacant' && !order.vacantReport && (order.status === 'paid' || order.status === 'accepted' || order.status === 'in_service')}}">
      <view class="section-title">空置房巡检报告提醒</view>
      <view class="muted">每次巡检单独授权一次通知；未授权时报告仍可在订单详情查看。</view>
      <button class="ui-button" wx:if="{{!order.visitReportNotifyAuthorized}}" bindtap="subscribeVacantReport" disabled="{{busy}}">订阅本次巡检报告</button>
      <view wx:else>已订阅本次报告提醒</view>
    </view>
    <view class="card" wx:if="{{order.serviceCode === 'visit' && order.visitReport}}">
      <view class="section-title">探访报告</view>
      <view wx:for="{{visitReportRows}}" wx:key="label">{{item.label}}：{{item.value}}</view>
      <view wx:if="{{order.visitReport.notes}}">补充说明：{{order.visitReport.notes}}</view>
      <view>需关注：{{order.visitReport.attention ? '是' : '否'}}</view>
    </view>
    <view class="card" wx:if="{{order.serviceCode === 'vacant' && order.vacantReport}}">
      <view class="section-title">巡检报告</view>
      <view wx:for="{{vacantReportRows}}" wx:key="label">{{item.label}}：{{item.value}}</view>
      <view>需关注：{{order.vacantReport.attention ? '是' : '否'}}</view>
      <view wx:if="{{order.vacantReport.notes}}">补充说明：{{order.vacantReport.notes}}</view>
      <block wx:for="{{vacantPhotoGroups}}" wx:key="label">
        <view>{{item.label}}</view>
        <private-media wx:for="{{item.photos}}" wx:for-item="photo" wx:key="*this" media-class="photo" src="{{photo}}" data-url="{{photo}}" bindtap="previewVacant" mode="aspectFill"/>
      </block>
    </view>
    <view class="card" wx:if="{{order.serviceCode === 'pet'}}">
      <view class="section-title">上门喂宠记录</view>
      <button class="ui-button" bindtap="openPetReports">查看每次上门记录</button>
    </view>
    <view class="card">
      <view class="section-title">服务信息</view>
      <view>{{order.address.buildingName}} {{order.address.unit}} {{order.address.room}}</view>
      <view>{{slotText}}</view>
      <view wx:for="{{detailRows}}" wx:key="label">{{item.label}}：{{item.value}}</view>
      <view wx:if="{{order.note}}">备注：{{order.note}}</view>
    </view>
    <view class="card" wx:if="{{order.providerLocation}}">
      <view class="section-title">服务员位置 · {{order.providerLocation.minutesAgo}} 分钟前</view>
      <map latitude="{{order.providerLocation.latitude}}" longitude="{{order.providerLocation.longitude}}" markers="{{mapMarkers}}" scale="15" show-location style="width:100%;height:360rpx"/>
    </view>
    <view class="card" wx:if="{{order.kind === 'idle_purchase' && order.detail.images.length}}">
      <view class="section-title">商品照片</view>
      <private-media wx:for="{{order.detail.images}}" wx:key="*this" media-class="photo" src="{{item}}" mode="aspectFill"/>
    </view>
    <view class="card" wx:if="{{order.provider}}">
      <view class="section-title">服务员</view>
      <private-media wx:if="{{order.provider.avatarFileId}}" media-class="avatar" src="{{order.provider.avatarFileId}}" mode="aspectFill"/>
      <view>{{order.provider.name}} · {{order.provider.level === 2 ? '认证服务员' : '邻居帮手'}}</view>
      <view>{{order.provider.phone}}</view>
      <button class="ui-button" wx:if="{{order.provider.canCall}}" bindtap="callProvider">联系服务员</button>
    </view>
    <view class="card" wx:if="{{order.photos.length}}">
      <view class="section-title">完成照片</view>
      <private-media wx:for="{{order.photos}}" wx:key="*this" media-class="photo" src="{{item}}" data-url="{{item}}" bindtap="preview" mode="aspectFill"/>
    </view>
    <view class="card" wx:if="{{refunds.length}}">
      <view class="section-title">退款记录</view>
      <view wx:for="{{refunds}}" wx:key="index">¥{{item.amountText}} · {{item.statusText}}<view>{{item.reason}}</view></view>
    </view>
    <view class="card">
      <view class="section-title">服务进度</view>
      <status-timeline items="{{timeline}}"/>
    </view>
    <button class="ui-button" wx:if="{{order.canPay}}" type="primary" bindtap="pay" loading="{{busy}}" disabled="{{busy}}">继续支付</button>
    <button class="ui-button" wx:if="{{order.canCancel}}" bindtap="cancel" disabled="{{busy}}">取消订单</button>
    <view class="card" wx:if="{{order.canConfirm}}"><button class="ui-button" type="primary" data-action="confirm" bindtap="serviceAction" disabled="{{busy}}">确认服务完成</button></view>
    <view class="card" wx:if="{{order.canRate}}">
      <view class="section-title">评价服务</view>
      <view>评分（1—5 分）</view>
      <input type="number" value="{{ratingScore}}" data-field="ratingScore" bindinput="form" maxlength="1"/>
      <textarea value="{{ratingText}}" data-field="ratingText" bindinput="form" maxlength="100" placeholder="写下服务感受（选填）"/>
      <button class="ui-button" data-action="rate" bindtap="serviceAction" disabled="{{busy}}">提交评价</button>
    </view>
    <view class="card" wx:if="{{order.canComplain}}">
      <view class="section-title">申请售后</view>
      <picker range="{{complaintReasons}}" value="{{complaintIndex}}" data-field="complaintIndex" bindchange="form"><view class="picker">{{complaintReasons[complaintIndex]}}</view></picker>
      <textarea value="{{complaintText}}" data-field="complaintText" bindinput="form" maxlength="500" placeholder="请描述遇到的问题"/>
      <button class="ui-button" data-action="complain" bindtap="serviceAction" disabled="{{busy}}">提交投诉</button>
    </view>
    <view class="card" wx:if="{{order.rating}}">已评价 {{order.rating.score}} 分<view>{{order.rating.text}}</view></view>
    <view class="card" wx:if="{{order.complaint}}">
      <view>售后原因：{{order.complaint.reason}}</view>
      <view>{{order.complaint.text}}</view>
      <view wx:if="{{order.complaint.resolution}}">处理结果：{{order.complaint.resolution.note}}</view>
    </view>
    <button class="ui-button" bindtap="load">刷新订单</button>
  </block>
</view>

</block>
