.profile-heading{display:flex;align-items:center;gap:24rpx;padding:12rpx 8rpx 36rpx}.avatar-disc{width:132rpx;height:132rpx;display:flex;align-items:center;justify-content:center;background:#E3EDDA;border-radius:50%;flex-shrink:0}.profile-avatar{width:106rpx;height:106rpx}.profile-name{font-size:42rpx;font-weight:600;margin-bottom:8rpx}.profile-heading .muted{margin-top:8rpx}.profile-address{display:flex;align-items:center;gap:20rpx;padding:28rpx 24rpx;background:#E8F0DF;border-radius:20rpx;box-sizing:border-box}.address-icon{width:76rpx;height:76rpx;flex-shrink:0}.profile-card-title{font-size:36rpx;font-weight:600}.profile-action{flex-shrink:0;color:#FFF;background:#1F7A5C;border-radius:40rpx;padding:12rpx 20rpx;font-size:32rpx}.account-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin-bottom:28rpx}.account-item{display:flex;align-items:center;justify-content:flex-start;gap:16rpx;min-height:112rpx;padding:20rpx;background:#F1F1E9;border:0;box-sizing:border-box;border-radius:20rpx;font-weight:550;font-size:32rpx;margin:0;width:100%;color:#243B2D;line-height:1.5}.legal-menu{border:1rpx solid #E6E9DF;border-radius:22rpx;overflow:hidden;margin-top:28rpx}.legal-menu .menu-row:last-child{border-bottom:0}

.profile-address{background:#E4F0DF}.profile-action{min-width:128rpx;text-align:center;box-sizing:border-box;padding:12rpx 24rpx;line-height:1.5}.profile-heading .pill{padding:0 12rpx;font-weight:500}.account-item .menu-icon{width:64rpx;height:64rpx}.account-grid{margin-bottom:40rpx}.join-neighbors{display:flex;align-items:center;gap:24rpx;padding:24rpx;border-radius:20rpx;background:#EDF3E3}.join-icon{width:92rpx;height:92rpx;flex-shrink:0}.join-title{font-size:36rpx;font-weight:600}.legal-menu .menu-icon{width:44rpx;height:44rpx}.legal-menu .menu-row{min-height:92rpx;padding:18rpx 24rpx}.profile-heading .muted{line-height:1.4}

.workspace-row{width:100%;margin:0;text-align:left;justify-content:flex-start;font-weight:500}.workspace-row .menu-icon{width:64rpx;height:64rpx}.workspace-row .menu-copy{line-height:1.5}.workspace-row .muted{font-weight:400}

.workspace-error{padding:20rpx 24rpx;background:#FFF3EB;border-radius:16rpx;margin:12rpx 0 24rpx;line-height:1.5;word-break:break-all}.workspace-error .btn-secondary{margin-top:16rpx;min-height:88rpx}
