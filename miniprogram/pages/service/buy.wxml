<view class="page service-page"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/buy.png"/><view class="masthead-copy"><view class="page-title">周边代买</view><view class="masthead-subtitle">生活所需，邻里代买</view></view></view><view wx:if="{{restoredDraft && community && !createdOrderId}}" class="card restored">{{recoveryHint || "已恢复上次未完成的填写内容"}}</view><view wx:if="{{createdOrderId}}" class="card">
    <view class="section-title">订单已创建</view>
    <view class="muted">请前往已有订单查看状态或继续支付，无需重复下单。</view>
    <view wx:if="{{navigationError}}" class="error">{{navigationError}}</view>
    <button bindtap="openCreatedOrder" loading="{{navigating}}" disabled="{{saving || navigating}}">前往已有订单</button>
  </view><empty-state wx:if="{{loading}}" message="正在加载…"/><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view><block wx:if="{{community && !createdOrderId}}"><view class="card"><view class="field" wx:if="{{addresses.length > 1}}"><text class="label">服务地址</text><picker range="{{addresses}}" range-key="buildingName" value="{{addressIndex}}" bindchange="addressChange"><view class="picker">{{addressText}} · 切换地址</view></picker></view><view wx:else bindtap="address"><text class="label">上门地址</text>{{addressText}}<view class="muted">点击添加/修改服务地址 ›</view></view></view><view class="card"><view class="field"><text class="label">店名</text><input value="{{form.shop}}" data-field="shop" bindinput="change" maxlength="100"/></view><view class="field"><text class="label">代买清单（最多 200 字）</text><textarea value="{{form.items}}" data-field="items" bindinput="change" maxlength="200" placeholder="请写明商品、数量和替代要求"/></view><view class="field"><text class="label">商品预付上限（元）</text><input type="digit" value="{{form.goodsYuan}}" data-field="goodsYuan" bindinput="change"/><text class="muted">商品款不参与服务费折扣，完成后凭小票退还差额。</text></view><view class="field"><text class="label">上门时间</text><picker range="{{slots}}" range-key="label" value="{{slotIndex}}" bindchange="slotChange"><view class="picker">{{slots[slotIndex].label || "请选择时段"}}</view></picker><view class="muted">{{dutyHint}}</view></view><view class="field"><text class="label">备注（选填）</text><textarea value="{{form.note}}" data-field="note" bindinput="change" maxlength="100" placeholder="请填写需要服务员注意的事项"/></view></view><discount-selector wx:if="{{(quote && (couponsEnabled || pointsEnabled)) || (restoredDraft && (couponChoice !== '__auto' || pointsToUse))}}" coupon-options="{{couponOptions}}" coupon-choice="{{couponChoice}}" coupons-enabled="{{couponsEnabled || (restoredDraft && couponChoice !== '__auto')}}" points-enabled="{{pointsEnabled || (restoredDraft && pointsToUse > 0)}}" points-balance="{{pointsBalance}}" points-to-use="{{pointsToUse}}" bind:couponchange="couponChange" bind:pointschange="pointsChange"/><view wx:if="{{quoteError}}" class="error">{{quoteError}}<button class="retry" bindtap="retryQuote">重新报价</button></view><view wx:if="{{quoteLoading}}">正在重新报价…</view><price-bar amount="{{amount}}" reason="{{quote && quote.reason || ''}}" disabled="{{!quote || quoteLoading || !slots.length}}" loading="{{saving}}" bind:submit="submit"/></block></view>
