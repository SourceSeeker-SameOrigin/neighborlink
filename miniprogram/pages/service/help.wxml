<view class="page service-page"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/help.png"/><view class="masthead-copy"><view class="page-title">帮把手</view><view class="masthead-subtitle">搬运与生活协助</view></view></view><view wx:if="{{restoredDraft && community && !createdOrderId}}" class="card restored">{{recoveryHint || "已恢复上次未完成的填写内容"}}</view><view wx:if="{{createdOrderId}}" class="card">
    <view class="section-title">订单已创建</view>
    <view class="muted">请前往已有订单查看状态或继续支付，无需重复下单。</view>
    <view wx:if="{{navigationError}}" class="error">{{navigationError}}</view>
    <button bindtap="openCreatedOrder" loading="{{navigating}}" disabled="{{saving || navigating}}">前往已有订单</button>
  </view><empty-state wx:if="{{loading}}" message="正在加载…"/><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view><block wx:if="{{community && !createdOrderId}}"><view class="card"><view class="field" wx:if="{{addresses.length > 1}}"><text class="label">服务地址</text><picker range="{{addresses}}" range-key="buildingName" value="{{addressIndex}}" bindchange="addressChange"><view class="picker">{{addressText}} · 切换地址</view></picker></view><view wx:else bindtap="address"><text class="label">上门地址</text>{{addressText}}<view class="muted">点击添加/修改服务地址 ›</view></view></view><view class="card"><view class="field"><text class="label">服务类别</text><picker range="{{categories}}" value="{{form.categoryIndex}}" data-field="categoryIndex" bindchange="change"><view class="picker">{{categories[form.categoryIndex]}}</view></picker></view><view class="field"><text class="label">需要什么帮助（最多 200 字）</text><textarea value="{{form.desc}}" data-field="desc" bindinput="change" maxlength="200"/></view><view class="field" wx:if="{{community.prices.help.billingMode === 'per_visit'}}"><text class="label">单次服务</text><view>每次包含 {{community.prices.help.includedMinutes}} 分钟</view><text class="muted">仅由认证服务员提供。超时不自动扣费，继续服务须另行确认新订单。</text></view><view class="field" wx:else><text class="label">预计时长（每块 15 分钟，1—8 块）</text><input type="number" value="{{form.blocks}}" data-field="blocks" bindinput="change"/><text class="muted">仅由认证服务员提供，按预计时长收费。</text></view><view class="field"><text class="label">上门时间</text><picker range="{{slots}}" range-key="label" value="{{slotIndex}}" bindchange="slotChange"><view class="picker">{{slots[slotIndex].label || "请选择时段"}}</view></picker><view class="muted">{{dutyHint}}</view></view><view class="field"><text class="label">备注（选填）</text><textarea value="{{form.note}}" data-field="note" bindinput="change" maxlength="100" placeholder="请填写需要服务员注意的事项"/></view></view><discount-selector wx:if="{{(quote && (couponsEnabled || pointsEnabled)) || (restoredDraft && (couponChoice !== '__auto' || pointsToUse))}}" coupon-options="{{couponOptions}}" coupon-choice="{{couponChoice}}" coupons-enabled="{{couponsEnabled || (restoredDraft && couponChoice !== '__auto')}}" points-enabled="{{pointsEnabled || (restoredDraft && pointsToUse > 0)}}" points-balance="{{pointsBalance}}" points-to-use="{{pointsToUse}}" bind:couponchange="couponChange" bind:pointschange="pointsChange"/><view wx:if="{{quoteError}}" class="error">{{quoteError}}<button class="retry" bindtap="retryQuote">重新报价</button></view><view wx:if="{{quoteLoading}}">正在重新报价…</view><price-bar amount="{{amount}}" reason="{{quote && quote.reason || ''}}" disabled="{{!quote || quoteLoading || !slots.length}}" loading="{{saving}}" bind:submit="submit"/></block></view>
