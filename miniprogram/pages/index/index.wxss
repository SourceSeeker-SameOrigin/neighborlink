.home-location{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:16rpx}.location-action{display:flex;align-items:center;gap:10rpx;min-width:0;min-height:88rpx;flex:1;font-weight:550}.location-action .ui-text{overflow-wrap:break-word}.location-icon{height:40rpx;width:40rpx;flex-shrink:0}.login-state{font-size:32rpx;color:#1F7A5C;flex-shrink:0}.welcome-banner{position:relative;overflow:hidden;min-height:248rpx;border-radius:20rpx;background:#EAF1DF;padding:28rpx;box-sizing:border-box}.neighborhood-art{position:absolute;right:-8rpx;bottom:0;width:360rpx;height:248rpx;opacity:1}.welcome-copy{position:relative;z-index:1;width:100%}.welcome-title{font-size:40rpx;line-height:1.4;font-weight:600;color:#184F38}.welcome-caption{font-size:32rpx;color:#40553E;margin-top:10rpx;max-width:350rpx}.welcome-action{display:inline-flex;align-items:center;justify-content:center;padding:12rpx 28rpx;margin-top:20rpx;border-radius:44rpx;background:#1F7A5C;color:#FFF;font-size:32rpx;min-height:88rpx;line-height:1.5}.services{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16rpx}.offer{padding:24rpx;margin-top:20rpx;border-radius:20rpx;background:#EAF1E2;color:#20583F}.membership-banner{display:flex;align-items:center;gap:18rpx;padding:24rpx 20rpx;margin:24rpx 0;background:#FFF1D6;border-radius:22rpx}.membership-icon{width:76rpx;height:76rpx;flex-shrink:0}.membership-title{font-size:34rpx;font-weight:600}.catalog-note{color:#687466;font-size:32rpx;margin:-8rpx 0 20rpx}.catalog-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:#FFF;border:1rpx solid #E3E7DB;border-radius:20rpx;overflow:hidden}.catalog-item{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;min-height:146rpx;padding:12rpx 6rpx;margin:0;border-radius:0;background:#FFF;border-right:1rpx solid #E9EBE2;border-bottom:1rpx solid #E9EBE2;font-size:32rpx;line-height:1.5;font-weight:500;color:#243B2D}.catalog-item:nth-child(3n){border-right:0}.catalog-item:nth-last-child(-n+3){border-bottom:0}.catalog-icon{width:72rpx;height:72rpx;margin-bottom:10rpx}.enabled-services{border-radius:22rpx;overflow:hidden;margin-top:24rpx}.hotline-button{display:flex;align-items:center;justify-content:center;gap:16rpx;margin-top:24rpx}.home-ads{height:300rpx;margin:24rpx 0;border-radius:22rpx;overflow:hidden}.ad-card{position:relative;height:100%;background:#EAF1E2}.ad-photo{width:100%;height:100%}.ad-label{position:absolute;top:16rpx;right:16rpx;padding:4rpx 12rpx;border-radius:8rpx;color:#FFF;background:#40553E;font-size:32rpx}.ad-title{position:absolute;left:18rpx;bottom:16rpx;color:#FFF;text-shadow:0 1rpx 4rpx #243B2D}.notice{display:flex;gap:18rpx;align-items:center;margin-top:24rpx}.notice-label{color:#1F7A5C;font-weight:600;flex-shrink:0}

.home-page{padding-top:8rpx}.catalog-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;flex-wrap:wrap;margin-top:28rpx;margin-bottom:16rpx}.catalog-heading .section-title{margin:0}.catalog-heading .catalog-note{margin:0;line-height:1.4;max-width:440rpx}.welcome-caption{max-width:430rpx}.welcome-action{min-height:88rpx;box-sizing:border-box;padding:12rpx 28rpx}.membership-banner{padding:20rpx 24rpx;margin:24rpx 0;gap:20rpx}.membership-icon{width:88rpx;height:88rpx}.catalog-grid{background:#FFFEFB}.catalog-item{background:#FFFEFB}.home-page .page-footer{display:none}
