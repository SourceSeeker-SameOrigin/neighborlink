<view class="page home-page">
  <view wx:if="{{loading}}" class="card muted">正在加载小区服务…</view>
  <view wx:elif="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view>
  <block wx:else>
    <view class="home-location"><navigator url="/pages/bind/bind" class="location-action"><image src="/assets/icons/pin.png" class="location-icon"/><text class="ui-text">{{community ? community.name : '选择服务小区'}}</text><text class="ui-text chevron">›</text></navigator><text class="ui-text login-state">已登录</text></view>
    <view class="welcome-banner"><image class="neighborhood-art" src="/assets/illustrations/neighborhood.png" mode="aspectFit"/><view class="welcome-copy"><view class="welcome-title">邻里小事，有人帮忙</view><view class="welcome-caption">{{needsBinding ? '完善门牌，查看本小区服务' : '日常生活的帮手，就在身边'}}</view><navigator class="welcome-action" url="/pages/bind/bind">{{needsBinding ? '去绑定门牌' : '查看服务门牌'}} ›</navigator></view></view>
    <view wx:if="{{notice}}" class="notice card" bindtap="openNotices"><text class="ui-text notice-label">公告</text><text class="ui-text">{{notice.title}}</text><text class="ui-text chevron">›</text></view>
    <swiper wx:if="{{ads.length}}" class="home-ads" indicator-dots autoplay circular><swiper-item wx:for="{{ads}}" wx:key="_id" data-id="{{item._id}}" bindtap="openAd"><view class="ad-card"><private-media media-class="ad-photo" src="{{item.imageFileId}}" mode="aspectFill" data-id="{{item._id}}" bindload="recordAd"/><text class="ui-text ad-label">广告</text><text class="ui-text ad-title">{{item.title}}</text></view></swiper-item></swiper>
    <view class="section-title">日常帮忙</view>
    <view class="services"><service-tile class="service-cell" wx:for="{{services}}" wx:key="code" code="{{item.code}}" name="{{item.name}}" icon="{{item.icon}}" subtitle="{{item.subtitle}}" url="{{item.url || ''}}"/></view>
    <view wx:if="{{firstOrder}}" class="offer">首单服务费低至 1 元<view class="muted">适用于取快递、扔垃圾和代买，商品款另计</view></view>
    <navigator class="membership-banner" url="{{needsBinding ? '/pages/bind/bind' : '/pages/membership/index'}}"><image src="/assets/icons/ticket.png" class="membership-icon"/><view><view class="membership-title">常用服务，看看月卡</view><view class="muted">快递月卡 · 垃圾月卡</view></view><text class="ui-text chevron">›</text></navigator>
    <view class="catalog-heading"><view class="section-title">全部服务</view><view class="catalog-note">按本小区开放情况使用</view></view>
    <view class="catalog-grid"><button wx:for="{{serviceCatalog}}" wx:key="code" class="catalog-item" data-code="{{item.code}}" bindtap="introduce"><image src="/assets/icons/{{item.icon}}.png" class="catalog-icon"/><text class="ui-text">{{item.name}}</text><text class="catalog-status">{{item.statusText}}</text></button></view>
    <block wx:if="{{community}}">
      <button class="hotline-button" bindtap="callHotline"><image src="/assets/icons/support.png" class="menu-icon"/>不会用？打电话下单</button>
    </block>
    <view class="page-footer">邻里互助，安心到家</view>
  </block>
</view>
<privacy-popup />
