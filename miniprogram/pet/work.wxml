<view wx:if="{{missingRecord}}" class="page"><view class="card"><view class="section-title">缺少订单编号</view><view class="muted">请从服务员工作台选择记录后重新进入。</view><navigator url="/provider/workbench/workbench" open-type="redirect"><button class="ui-button">前往服务员工作台</button></navigator></view></view>
<block wx:else>
<view class="page"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/pet.png"/><view class="masthead-copy"><view class="page-title">喂宠上门清单</view><view class="masthead-subtitle">照顾家里的小伙伴</view></view></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">刷新</button></view><view wx:if="{{loading}}">正在加载…</view><view wx:for="{{visits}}" wx:key="_id" class="card"><view class="section-title">{{item.date}} · 第 {{item.seq}} 次</view><view>状态：{{item.status === 'pending' ? '待服务' : item.status === 'done' ? '已完成' : '未完成'}}</view><button wx:if="{{entryMode === 'password' && item.status === 'pending'}}" data-id="{{item._id}}" disabled="{{readingEntry}}" bindtap="reveal">查看门锁密码（仅当日）</button><button wx:if="{{item.status === 'pending'}}" data-id="{{item._id}}" disabled="{{busy || loading || parentStatus !== 'in_service'}}" bindtap="done">提交本次服务凭证</button><button wx:if="{{item.status === 'pending'}}" data-id="{{item._id}}" disabled="{{busy || loading || parentStatus !== 'in_service'}}" bindtap="missed">登记本次未完成</button></view><view wx:if="{{entryPassword}}" class="secret" catchtap="closeSecret">门锁密码：{{entryPassword}}<button size="mini" bindtap="closeSecret">关闭</button></view></view>

</block>
