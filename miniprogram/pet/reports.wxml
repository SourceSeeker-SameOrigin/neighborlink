<view wx:if="{{missingRecord}}" class="page"><view class="card"><view class="section-title">缺少订单编号</view><view class="muted">请从我的订单选择记录后重新进入。</view><navigator url="/pages/orders/list" open-type="switchTab"><button class="ui-button">前往我的订单</button></navigator></view></view>
<block wx:else>
<view class="page"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/pet.png"/><view class="masthead-copy"><view class="page-title">喂宠服务记录</view><view class="masthead-subtitle">照顾家里的小伙伴</view></view></view><view wx:if="{{loading}}">正在加载…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">刷新</button></view><view wx:for="{{visits}}" wx:key="_id" class="card"><view class="section-title">{{item.date}} · 第 {{item.seq}} 次</view><view>{{item.status === 'done' ? '已完成' : item.status === 'missed' ? '未完成' : '待服务'}}</view><private-media media-class="media-photo" wx:for="{{item.photos}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill"/><private-media media-class="media-photo" kind="video" wx:if="{{item.videoFileId}}" src="{{item.videoFileId}}" controls/></view></view>

</block>
