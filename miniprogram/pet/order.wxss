.date-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0 12rpx; }
.date-actions { display: flex; align-items: center; }
.date-action { display: flex; align-items: center; justify-content: center; min-height: 88rpx; min-width: 88rpx; color: #315F49; }
.ui-input { padding: 0 8rpx; background: #F5F6F0; }
.pet-count-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; min-height: 100rpx; }
.pet-count-row .label { margin: 0; flex: 1; }
.pet-count-row .count-input { width: 160rpx; flex: none; height: 88rpx; min-height: 88rpx; text-align: center; box-sizing: border-box; }
.pet-tasks { display: flex; flex-wrap: wrap; gap: 12rpx 24rpx; }
.pet-task { display: flex; align-items: center; gap: 8rpx; min-height: 88rpx; }
