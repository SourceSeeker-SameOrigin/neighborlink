<view class="page service-page"><view wx:if="{{restoredDraft && community && !createdOrderId}}" class="card restored">{{recoveryHint || "已恢复上次未完成的填写内容"}}</view><view wx:if="{{createdOrderId}}" class="card">
    <view class="section-title">订单已创建</view>
    <view class="muted">请前往已有订单查看状态或继续支付，无需重复下单。</view>
    <view wx:if="{{navigationError}}" class="error">{{navigationError}}</view>
    <button bindtap="openCreatedOrder" loading="{{navigating}}" disabled="{{saving || navigating}}">前往已有订单</button>
  </view><empty-state wx:if="{{loading}}" message="正在加载…"/><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><block wx:if="{{community && !createdOrderId}}"><view class="card"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/pet.png"/><view class="masthead-copy"><view class="page-title">上门喂宠</view><view class="masthead-subtitle">照顾家里的小伙伴</view></view></view><view class="muted">服务员会按排期完成每次上门，并上传服务记录。</view><view wx:if="{{addresses.length > 1}}" class="field"><text class="label">服务地址</text><picker range="{{addresses}}" range-key="buildingName" value="{{addressIndex}}" bindchange="addressChange"><view class="picker">{{addressText}} · 切换地址</view></picker></view></view><view class="card"><view class="section-title">服务日期（最多 15 天）</view>
    <view wx:if="{{petHasExpiredDates}}" class="muted">请移除或更换已过期的日期，其他服务日期会保留。</view>
    <view wx:for="{{form.dates}}" wx:key="*this" class="date-row">
      <text>{{item}}{{petDateStart > item ? '（已过期）' : ''}}</text>
      <view class="date-actions">
        <picker wx:if="{{petDateStart > item}}" mode="date" start="{{petDateStart}}" value="{{petDateStart}}" data-date="{{item}}" bindchange="addPetDate"><view class="date-action">换日</view></picker>
        <text class="date-action" data-date="{{item}}" bindtap="removePetDate">移除</text>
      </view>
    </view>
    <picker mode="date" start="{{petDateStart}}" value="{{petDateStart}}" bindchange="addPetDate"><view class="picker">添加服务日期 ›</view></picker><picker range="{{visitsPerDayOptions}}" value="{{form.visitsPerDay - 1}}" bindchange="change" data-field="visitsPerDay"><view class="picker">每天上门 {{form.visitsPerDay}} 次（点此切换）</view></picker></view><view class="card"><view class="section-title">宠物</view><view class="pet-count-row"><text class="label">猫数量</text><input class="ui-input count-input" type="number" value="{{form.catCount}}" data-field="catCount" bindinput="change"/></view><view class="pet-count-row"><text class="label">狗数量</text><input class="ui-input count-input" type="number" value="{{form.dogCount}}" data-field="dogCount" bindinput="change"/></view><view class="pet-count-row"><text class="label">其他宠物数量</text><input class="ui-input count-input" type="number" value="{{form.otherCount}}" data-field="otherCount" bindinput="change"/></view><view class="section-title">服务事项</view><checkbox-group class="pet-tasks" data-field="tasks" bindchange="change"><label class="pet-task" wx:for="{{taskChoices}}" wx:key="value"><checkbox value="{{item.value}}" checked="{{item.checked}}"/>{{item.label}}</label></checkbox-group></view><view class="card"><view class="section-title">入户方式</view><picker range="{{entryMethods}}" value="{{form.entryIndex}}" data-field="entryIndex" bindchange="change"><view class="picker">{{entryMethods[form.entryIndex]}}</view></picker><view class="field" wx:if="{{form.entryIndex === 0}}"><view class="label">门锁密码</view><input class="ui-input" password value="{{form.entryPassword}}" data-field="entryPassword" bindinput="change" placeholder="加密保存，仅服务日期可查"/></view></view><view class="card"><view class="field"><text class="label">任务分配时段</text><picker range="{{slots}}" range-key="label" value="{{slotIndex}}" bindchange="slotChange"><view class="picker">{{slots[slotIndex].label || '请选择'}}</view></picker></view><view class="muted">此时段用于分配整笔喂宠任务；每日上门日期按上方列表执行。</view></view><view wx:if="{{quoteError}}" class="error">{{quoteError}}<button bindtap="retryQuote">重新报价</button></view><price-bar amount="{{amount}}" reason="{{quote && quote.reason || ''}}" disabled="{{petHasExpiredDates || !form.dates.length || !quote || quoteLoading || !slots.length}}" loading="{{saving}}" bind:submit="submit"/></block></view><privacy-popup/>
