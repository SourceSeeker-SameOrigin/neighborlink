.card{padding:28rpx;background:#FFF;border:1rpx solid #E3E7DB;border-radius:24rpx;margin:24rpx 0;font-size:32rpx;color:#243B2D;line-height:1.6}.row{display:flex;justify-content:space-between;align-items:center;gap:16rpx;flex-wrap:wrap}.heading{padding-bottom:20rpx;border-bottom:1rpx solid #EDF0E7}.service{display:flex;align-items:center;gap:12rpx;font-weight:600;font-size:34rpx}.order-icon{width:44rpx;height:44rpx}.status{padding:4rpx 14rpx;background:#EDF2E6;border-radius:24rpx;color:#20583F;font-size:32rpx}.address{margin-top:20rpx}.muted{color:#687466;font-size:32rpx}.summary{margin-top:20rpx}.amount{font-size:40rpx;font-weight:650;color:#1F7A5C}.hint{display:flex;justify-content:space-between;color:#1F7A5C;margin-top:20rpx;padding-top:20rpx;border-top:1rpx solid #EDF0E7}
