.bar{position:fixed;bottom:0;left:0;right:0;z-index:10;box-sizing:border-box;background:#FFF;padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));display:flex;align-items:center;justify-content:space-between;gap:20rpx;border-top:1rpx solid #E3E7DB;box-shadow:0 -6rpx 24rpx rgba(36,59,45,.04);font-size:32rpx;color:#243B2D}.price-copy{flex:1;min-width:0}.total{font-size:32rpx}.amount{font-size:44rpx;font-weight:650;color:#1F7A5C}.reason{font-size:32rpx;color:#687466;overflow-wrap:break-word;margin-top:4rpx}.submit-button{margin:0;min-height:92rpx;max-width:45%;box-sizing:border-box;padding:20rpx 28rpx;line-height:1.5;white-space:normal;font-size:32rpx;font-weight:600;border-radius:20rpx;background:#1F7A5C;color:#FFF;flex-shrink:0}.submit-button::after{border:0}.submit-button.is-disabled{background:#B6D0B4;color:#FFF}
