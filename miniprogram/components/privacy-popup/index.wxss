.overlay{position:fixed;inset:0;z-index:999;background:rgba(24,45,31,.5);display:flex;align-items:center;justify-content:center}.dialog{box-sizing:border-box;margin:32rpx;padding:36rpx;border-radius:28rpx;background:#FFFEFB;color:#243B2D;font-size:32rpx;line-height:1.75;max-height:86vh;overflow-y:auto;border:1rpx solid #E3E7DB}.title{font-size:42rpx;font-weight:650;color:#184F38;margin-bottom:20rpx}.privacy-action{margin-top:20rpx;font-size:32rpx;min-height:88rpx;padding:18rpx 22rpx;line-height:1.6;border-radius:18rpx;background:#EDF2E6;color:#20583F}.privacy-action::after{border:0}.privacy-primary{background:#1F7A5C;color:#FFF}
