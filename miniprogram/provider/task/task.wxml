<view wx:if="{{missingRecord}}" class="page"><view class="card"><view class="section-title">缺少任务编号</view><view class="muted">请从服务员工作台选择记录后重新进入。</view><navigator url="/provider/workbench/workbench" open-type="redirect"><button class="ui-button">前往服务员工作台</button></navigator></view></view>
<block wx:else>
<view class="page"><empty-state wx:if="{{loading}}" message="正在加载…"/><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="load"/><block wx:if="{{order}}"><view class="card"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/help.png"/><view class="masthead-copy"><view class="page-title">{{order.serviceName}} · {{order.statusText}}</view><view class="masthead-subtitle">邻里服务 · 用心履约</view></view></view><view>{{order.address.buildingName}} {{order.address.unit}} {{order.address.room}}</view><view>{{slotText}}</view><view>住户电话：{{order.userPhone}}</view><button class="ui-button" wx:if="{{order.canCallResident}}" bindtap="callResident" disabled="{{callingResident || loading || !taskReady}}">联系住户</button><button class="ui-button" wx:if="{{order.chatEnabled}}" bindtap="openChat">站内聊天</button><view wx:if="{{pickupText}}">取件码：{{pickupText}}</view><view wx:if="{{order.detail.stationCode}}">驿站：{{order.detail.stationCode}}</view><view wx:if="{{order.detail.shop}}">商店：{{order.detail.shop}}</view><view wx:if="{{order.detail.items}}">清单：{{order.detail.items}}</view><view wx:if="{{order.detail.desc}}">服务描述：{{order.detail.desc}}</view><view wx:if="{{order.serviceCode === 'pet'}}">服务日期：{{order.detail.dates}} · 每天 {{order.detail.visitsPerDay}} 次</view><view wx:if="{{order.serviceCode === 'pet'}}">入户方式：{{order.detail.entry}}</view><view wx:for="{{order.detail.pets}}" wx:key="kind">{{item.kind}} × {{item.count}}</view><view wx:if="{{order.serviceCode === 'pet'}}">事项：{{order.detail.tasks}}</view><button class="ui-button" wx:if="{{order.serviceCode === 'pet'}}" bindtap="openPetTasks">喂宠上门清单</button><view wx:if="{{order.serviceCode === 'vacant'}}">入户方式：{{entryText}}<button class="ui-button" wx:if="{{order.detail.entry === 'password'}}" bindtap="revealEntry" disabled="{{busy || readingEntry}}">查看当天门锁密码</button><view wx:if="{{entryPassword}}" class="card"><view>门锁密码：{{entryPassword}}</view><button class="ui-button" bindtap="closeSecret">关闭</button></view></view><view wx:if="{{order.serviceCode === 'recycle'}}" class="card"><view class="section-title">分类称重（kg，精确到 0.1）</view><view wx:for="{{recycleRows}}" wx:key="code">{{item.name}}<input type="digit" data-code="{{item.code}}" value="{{item.value}}" bindinput="weight" placeholder="重量"/></view></view><view wx:if="{{order.serviceCode === 'help' && order.detail.billingMode === 'per_visit'}}">单次服务包含 {{order.detail.includedMinutes}} 分钟；超时不自动扣费，继续服务须住户另行确认新订单。</view><view wx:if="{{order.detail.blocks}}">预计时长：{{order.detail.blocks * 15}} 分钟</view><view wx:if="{{order.detail.bags}}">垃圾：{{order.detail.bags}} 袋</view><view>备注：{{order.note || '无'}}</view></view><block wx:if="{{order.status === 'accepted'}}"><button class="ui-button" type="primary" wx:if="{{order.featureEnabled}}" data-action="start" bindtap="act" disabled="{{busy || loading || !taskReady}}">开始服务</button><button class="ui-button" data-action="release" bindtap="act" disabled="{{busy || loading || !taskReady}}">放弃任务</button></block><view class="card" wx:if="{{order.featureEnabled && order.status === 'in_service' && order.serviceCode !== 'pet'}}"><view class="section-title">完成凭证</view><view>拍摄服务结果，请勿拍摄无关人员或证件</view><private-media media-class="photo" wx:for="{{photos}}" wx:key="*this" src="{{item}}"/><button class="ui-button" data-type="photos" bindtap="photo" disabled="{{busy || uploading || loading || !taskReady}}" loading="{{uploading}}">拍摄完成照片（1—3 张）</button><block wx:if="{{order.serviceCode === 'buy' || order.serviceCode === 'meal'}}"><view>商品预付上限 ¥{{goodsCap}}</view><input type="digit" value="{{goodsYuan}}" bindinput="goods" placeholder="实际商品金额（元）"/><private-media wx:if="{{receiptPhoto}}" media-class="photo" src="{{receiptPhoto}}"/><button class="ui-button" data-type="receipt" bindtap="photo" disabled="{{busy || uploading || loading || !taskReady}}" loading="{{uploading}}">拍摄小票</button></block><block wx:if="{{order.serviceCode === 'vacant'}}"><view class="section-title">空置房巡检清单</view><block wx:for="{{vacantItems}}" wx:key="key"><view class="inspection-item"><checkbox-group data-key="{{item.key}}" bindchange="checklist"><label><checkbox value="done" checked="{{checklist[item.key]}}"/>{{item.label}}</label></checkbox-group><view class="inspection-count">照片 {{photoByItem[item.key].length || 0}} / 3 张 · 至少1张</view><view class="inspection-photos"><view class="inspection-photo" wx:for="{{photoByItem[item.key]}}" wx:for-item="photo" wx:for-index="photoIndex" wx:key="*this"><private-media media-class="photo" src="{{photo}}"/><button class="ui-button" size="mini" data-key="{{item.key}}" data-index="{{photoIndex}}" data-file="{{photo}}" bindtap="removeVacantPhoto" disabled="{{busy || uploading || loading || !taskReady}}">移除照片</button></view></view><button class="ui-button" size="mini" data-key="{{item.key}}" bindtap="vacantPhoto" disabled="{{busy || uploading || loading || !taskReady || photoByItem[item.key].length >= 3}}" loading="{{uploading}}">{{photoByItem[item.key].length >= 3 ? '已满3张，移除后可重拍' : '上传该项照片'}}</button></view></block><textarea maxlength="500" value="{{vacantNotes}}" bindinput="vacantNotes" placeholder="补充说明（选填）"/><view><switch checked="{{vacantAttention}}" bindchange="vacantAttention"/>需要关注</view></block><block wx:if="{{order.serviceCode === 'visit'}}"><view class="section-title">探访检查清单</view><checkbox-group bindchange="visitCheck"><label><checkbox value="mental" checked="{{visitChecks.mental}}"/>精神状态</label><label><checkbox value="diet" checked="{{visitChecks.diet}}"/>饮食情况</label><label><checkbox value="utilities" checked="{{visitChecks.utilities}}"/>用电用气安全</label><label><checkbox value="doors" checked="{{visitChecks.doors}}"/>门窗安全</label><label><checkbox value="medical" checked="{{visitChecks.medical}}"/>是否需要就医</label></checkbox-group><textarea maxlength="500" value="{{visitNotes}}" bindinput="visitNotes" placeholder="补充探访情况（最多 500 字）"/><view><switch checked="{{visitAttention}}" bindchange="visitAttention"/>需要关注</view><view wx:if="{{visitAttention}}"><view class="error">请先电话通知下单人</view><view wx:if="{{attentionCallConfirmed}}">已发起电话联系，请确认已通知下单人</view></view></block><button class="ui-button" wx:if="{{order.serviceCode === 'vacant'}}" type="primary" bindtap="submitVacantReport" disabled="{{busy || uploading || loading || !taskReady}}" loading="{{busy}}">提交巡检报告</button><button class="ui-button" wx:else type="primary" data-action="deliver" bindtap="act" disabled="{{busy || uploading || loading || !taskReady}}" loading="{{busy}}">提交完成</button></view><view wx:if="{{order.status === 'delivered'}}" class="card">已提交完成，等待住户确认</view></block></view><privacy-popup/>

</block>
