<view class="page"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/help.png"/><view class="masthead-copy"><view class="page-title">任务大厅</view><view class="masthead-subtitle">邻里服务 · 用心履约</view></view></view><view class="muted">页面显示期间每 15 秒刷新一次</view><navigator wx:if="{{stationDeliveryEnabled}}" class="ui-navigator card menu-row" url="/station/worker/worker"><image class="menu-icon" src="/assets/icons/express.png"/><text class="menu-copy">驿站批量送上门任务</text><text class="chevron">›</text></navigator><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="retry"/><view class="card" wx:for="{{tasks}}" wx:key="_id"><view class="section-title">{{item.serviceName}} · {{item.buildingName}}</view><view wx:if="{{item.title}}">{{item.title}}</view><view wx:if="{{item.desc}}">{{item.desc}}</view><view wx:if="{{item.serviceCode === 'custom'}}">{{item.needEnterHome ? '需认证服务员入户' : '无需入户'}}</view><view>{{item.slotText}}</view><view>预计服务收入 ¥{{item.income}}</view><button class="ui-button" type="primary" data-id="{{item._id}}" disabled="{{busy || loading || !ready}}" bindtap="accept">接单</button></view><empty-state wx:if="{{loading}}" message="正在加载任务…"/><empty-state wx:elif="{{!error && !tasks.length && !hasMore}}" message="暂时没有可接任务"/><button wx:if="{{hasMore && !loading}}" class="ui-button" bindtap="more">继续查找任务</button></view>
