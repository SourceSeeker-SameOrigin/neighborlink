<view class="page"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/help.png"/><view class="masthead-copy"><view class="page-title">服务员申请</view><view class="masthead-subtitle">邻里服务 · 用心履约</view></view></view><empty-state wx:if="{{loading}}" message="正在加载…"/><empty-state wx:if="{{error}}" message="{{error}}" retry="{{errorKind === 'load'}}" bind:retry="load"/><view class="card" wx:if="{{ready && !loading && provider}}">申请状态：{{provider.status === 'pending' ? '审核中' : provider.status === 'approved' ? '已通过' : provider.status === 'rejected' ? '已拒绝' : '已停用'}}<view>{{provider.reviewNote}}</view><navigator class="ui-navigator" wx:if="{{provider.status === 'approved'}}" url="/provider/workbench/workbench">进入工作台 ›</navigator></view><view class="card" wx:if="{{ready && !loading && (!provider || provider.status === 'rejected')}}"><view class="field"><text class="label">真实姓名</text><input value="{{realName}}" data-field="realName" bindinput="change" maxlength="30"/></view><view class="field"><text class="label">手机号</text><view>{{phone}}</view><navigator class="ui-navigator contact-link" url="/pages/bind/bind">填写或修改联系电话 ›</navigator><view class="muted">手填号码未验证，不代替服务员资格审核。</view></view><view class="field"><text class="label">身份证后四位</text><input value="{{idLast4}}" data-field="idLast4" bindinput="change" maxlength="4"/></view><view class="field"><text class="label">身份证正面照片（仅用于审核，审核后删除）</text><button class="ui-button" data-type="kyc" bindtap="photo" disabled="{{!ready || loading || busy || uploading}}">{{kycFileId ? '重新拍摄证件' : '拍摄证件'}}</button><text wx:if="{{kycFileId}}">证件已上传</text></view><view class="field"><text class="label">工牌头像（住户可见）</text><private-media wx:if="{{avatarFileId}}" media-class="photo" src="{{avatarFileId}}"/><button class="ui-button" data-type="avatar" bindtap="photo" disabled="{{!ready || loading || busy || uploading}}">拍摄头像</button></view><view class="field"><text class="label">服务小区</text><picker range="{{communities}}" range-key="name" value="{{communityIndex}}" data-field="communityIndex" bindchange="change"><view class="picker">{{communities[communityIndex].name || '请选择小区'}}</view></picker></view><view class="field"><text class="label">申请等级</text><picker range="{{levels}}" value="{{levelIndex}}" data-field="levelIndex" bindchange="change"><view class="picker">{{levels[levelIndex]}}</view></picker></view><checkbox-group bindchange="agree"><label><checkbox value="yes" checked="{{agreed}}"/>同意服务规范：按时履约，保护住户隐私，不承接禁止事项</label></checkbox-group><navigator class="ui-navigator" url="/pages/legal/terms">查看服务协议 ›</navigator><button class="ui-button" type="primary" loading="{{busy}}" disabled="{{!ready || loading || busy || uploading}}" bindtap="submit">提交申请</button></view></view><privacy-popup/>
