<view wx:if="{{checkinScene}}" class="page"><view class="card"><view class="section-title">请由组织者扫码签到</view><view class="muted">这张码用于活动签到。请让活动组织者在「活动管理」中使用扫码签到；直接打开此页不会完成签到。</view><navigator url="/events/list/list" open-type="redirect"><button class="ui-button">查看活动列表</button></navigator></view></view>
<view wx:elif="{{missingRecord}}" class="page"><view class="card"><view class="section-title">缺少活动编号</view><view class="muted">请从活动列表选择记录后重新进入。</view><navigator url="/events/list/list" open-type="redirect"><button class="ui-button">前往活动列表</button></navigator></view></view>
<block wx:else>
<view class="page">
<view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button>
</view>
<view wx:if="{{item}}" class="card">
<view class="page-masthead">
<image class="masthead-icon" src="/assets/icons/events.png"/>
<view class="masthead-copy">
<view class="page-title">{{item.title}}</view>
<view class="masthead-subtitle">相聚社区，共享邻里时光</view>
</view>
</view>
<view>{{item.startText}} 至 {{item.endText}}</view>
<view>地点：{{item.location}}</view>
<view>费用：{{item.feeText}}</view>
<view>剩余名额：{{item.remaining}}</view>
<view>报名截止：{{item.deadlineText}}</view>
<view class="content">{{item.desc}}</view>
<private-media wx:for="{{item.images}}" wx:key="*this" src="{{item}}" mode="widthFix"/>
<view wx:if="{{item.mySignup}}" class="muted">报名状态：{{signupStatusNames[item.mySignup.status] || '状态待确认'}}<text wx:if="{{item.mySignup.checkinCode}}"> · 签到码 {{item.mySignup.checkinCode}}</text>
</view>
<private-media wx:if="{{item.mySignup.checkinQrUrl}}" media-class="qr" src="{{item.mySignup.checkinQrUrl}}" mode="aspectFit"/>
<view wx:if="{{actions.reason}}" class="muted">{{actions.reason}}</view>
<button wx:if="{{actions.canJoin}}" disabled="{{loading || busy}}" type="primary" loading="{{busy}}" bindtap="signup">报名</button>
<button wx:if="{{actions.canPay}}" disabled="{{loading || busy}}" type="primary" loading="{{busy}}" bindtap="signup">继续支付</button>
<button wx:if="{{actions.canCancel}}" disabled="{{loading || busy}}" loading="{{busy}}" bindtap="cancelSignup">取消报名</button>
</view>
<view wx:if="{{loading}}" class="card">正在加载…</view>
<view wx:if="{{item && reportError}}" class="error">举报未确认：{{reportError}}</view>
<button wx:if="{{item}}" class="ui-button" bindtap="reportContent">{{reportError ? '重试举报' : '举报活动'}}</button>
</view>

</block>
