<view class="page"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/events.png"/><view class="masthead-copy"><view class="page-title">社区活动</view><view class="masthead-subtitle">相聚社区，共享邻里时光</view></view></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view><view class="card" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="open"><view class="section-title">{{item.title}}</view><view>{{item.startText}} · {{item.location}}</view><view class="muted">{{item.feeText}} · 剩余 {{item.remaining}} 个名额</view></view><view wx:if="{{loading}}" class="card">正在加载…</view><view wx:elif="{{!list.length && !error}}" class="card">暂时没有活动</view></view>
