/* Reuse the approved shared card, label, input and button design. */
.export-picker { gap:20rpx; }
.export-value { flex:1; min-width:0; overflow-wrap:break-word; }
.export-arrow { flex-shrink:0; color:#71816D; font-size:40rpx; line-height:1; }
.field-help,.error-help { margin-top:16rpx; }
.export-note { margin-bottom:28rpx; }
.export-submit { margin-top:28rpx; }
