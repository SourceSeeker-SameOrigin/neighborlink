<view class="page"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/admin.png"/><view class="masthead-copy"><view class="page-title">订单管理</view><view class="masthead-subtitle">社区运营 · 按权限管理</view></view></view><view wx:if="{{readOnly}}" class="muted">物业只读视图</view><navigator wx:if="{{isAdmin}}" class="card menu-row" url="/admin/exports/exports?type=subsidy"><image class="menu-icon" src="/assets/icons/legal.png"/><text class="menu-copy">导出政府养老补贴业务明细</text><text class="chevron">›</text></navigator><picker range="{{statuses}}" value="{{statusIndex}}" bindchange="filter"><view class="picker">{{statuses[statusIndex]}} ▾</view></picker><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="retry"/><view class="card" wx:for="{{rows}}" wx:key="_id" data-id="{{item._id}}" bindtap="open"><view wx:if="{{item.alerted}}" class="error">超时未接单，请处理</view><view wx:if="{{item.attentionAlert}}" class="error">探访异常：请联系住户跟进</view><view>{{item.serviceName}} · {{item.statusText}}</view><view>{{item.buildingName}} · <text wx:if="{{item.status === 'pending_quote'}}">{{item.amount}}</text><text wx:else>¥{{item.amount}}</text></view><view>{{item.createdText}}</view><view>查看详情 ›</view></view><empty-state wx:if="{{loading}}" message="正在加载…"/><empty-state wx:elif="{{!error && !rows.length}}" message="没有符合条件的订单"/></view>
