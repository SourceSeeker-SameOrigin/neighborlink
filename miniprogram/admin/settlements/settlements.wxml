<view class="page"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/admin.png"/><view class="masthead-copy"><view class="page-title">{{isAdmin ? '人工结算' : '物业分成'}}</view><view class="masthead-subtitle">社区运营 · 按权限管理</view></view></view><view wx:if="{{loading}}">正在加载…</view><view wx:if="{{error}}" class="error">{{error}}<button disabled="{{loading || busy}}" bindtap="load">重新加载</button></view><block wx:if="{{authorized && ready}}"><view wx:if="{{!isAdmin}}" class="card muted">仅查看本小区物业分成，不可生成结算或标记付款。</view><picker disabled="{{!isAdmin}}" range="{{communities}}" range-key="name" value="{{communityIndex}}" data-field="communityIndex" bindchange="select"><view class="picker">{{communities[communityIndex].name || '选择小区'}}</view></picker><picker wx:if="{{isAdmin}}" range="{{payees}}" value="{{payeeIndex}}" data-field="payeeIndex" bindchange="select"><view class="picker">收款对象：{{payees[payeeIndex]}}</view></picker><picker wx:if="{{payeeIndex === 0}}" range="{{providers}}" range-key="realName" value="{{providerIndex}}" data-field="providerIndex" bindchange="select"><view class="picker">{{providers[providerIndex].realName || '选择服务员'}}</view></picker><picker wx:if="{{payeeIndex === 2}}" range="{{merchants}}" range-key="name" value="{{merchantIndex}}" data-field="merchantIndex" bindchange="select"><view class="picker">{{merchants[merchantIndex].name || '选择商家'}}</view></picker><input wx:if="{{payeeIndex === 3}}" value="{{sellerOpenid}}" data-field="sellerOpenid" bindinput="input" placeholder="卖家 OpenID（留空查看全部）"/><view class="field"><text class="label">期间开始</text><picker mode="date" value="{{from}}" data-field="from" bindchange="input"><view class="picker">{{from}}</view></picker></view><view class="field"><text class="label">期间结束</text><picker mode="date" value="{{to}}" data-field="to" bindchange="input"><view class="picker">{{to}}</view></picker></view><view class="actions"><button bindtap="preview" disabled="{{busy}}">预览待结算</button><button wx:if="{{isAdmin}}" type="primary" bindtap="create" disabled="{{busy}}">生成结算单</button><navigator wx:if="{{isAdmin}}" class="card menu-row" url="/admin/exports/exports?type=settlement"><image class="menu-icon" src="/assets/icons/legal.png"/><text class="menu-copy">前往统一数据导出</text><text class="chevron">›</text></navigator></view><view class="card" wx:for="{{preview}}" wx:key="previewKey"><view>{{item.payee === 'property' ? '物业' : item.payee === 'merchant' ? (item.merchantName || item.merchantId) : item.payee === 'seller' ? item.sellerOpenid : item.providerId}} · ¥{{item.totalText}}</view><view>{{previewRange.communityName}}</view><view>{{previewRange.from}} 至 {{previewRange.to}}</view><view wx:if="{{item.supplementOf}}">本次待补金额 ¥{{item.totalText}}；原结算单 ¥{{item.originalTotalText}}</view><view>包含 {{item.ledgerIds.length}} 条账目</view></view><view class="section-title">结算记录</view><view class="card" wx:for="{{settlements}}" wx:key="_id"><view>{{item.payee === 'property' ? '物业' : item.payee === 'merchant' ? (item.merchantName || item.merchantId) : item.payee === 'seller' ? item.sellerOpenid : item.providerId}} · ¥{{item.totalText}}</view><view>{{item.period.from}} 至 {{item.period.to}} · {{item.status === 'paid' ? '已付' : '待付款'}}{{item.supplementOf ? ' · 补充结算' : ''}}</view><button wx:if="{{isAdmin && item.status === 'draft'}}" data-id="{{item._id}}" bindtap="markPaid">标记已付</button></view>
<view wx:if="{{historyError}}" class="error">{{historyError}}</view>
<button wx:if="{{historyHasMore}}" loading="{{historyLoading}}" disabled="{{historyLoading || busy}}" bindtap="loadMoreHistory">{{historyError ? '重试加载结算记录' : '加载更多结算记录'}}</button>
<view wx:elif="{{!settlements.length}}" class="muted">暂无结算记录</view>
<view wx:else class="muted">已加载全部结算记录</view>
</block></view>
