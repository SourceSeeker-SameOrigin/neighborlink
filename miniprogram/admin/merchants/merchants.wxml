<view class="page">
<view class="page-masthead">
<image class="masthead-icon" src="/assets/icons/admin.png"/>
<view class="masthead-copy">
<view class="page-title">商家入驻审核</view>
<view class="masthead-subtitle">社区运营 · 按权限管理</view>
</view>
</view>
<picker range="{{statusLabels}}" value="{{statusIndex}}" bindchange="filter" disabled="{{busy || loading || !ready}}">
<view class="card">商家状态：{{statusLabels[statusIndex]}}</view>
</picker>
<view wx:if="{{error}}" class="error">{{error}}<button bindtap="retry" disabled="{{loading || busy}}">重试</button>
</view>
<view wx:for="{{list}}" wx:key="_id" class="card" data-id="{{item._id}}" bindtap="inspect">
<view class="section-title">{{item.name}} · {{item.categoryName}} · {{statusNames[item.status] || '状态待确认'}}</view>
<view>营业执照：{{item.licenseInfo.name}}</view>
<view>信用代码：{{item.licenseInfo.creditCode}}</view>
<private-media wx:if="{{item.licenseFileId}}" src="{{item.licenseFileId}}" mode="widthFix" media-class="license"/>
<view>{{item.contactName}} · {{item.phone}}</view>
</view>
<view wx:if="{{loading}}">正在加载…</view>
<view wx:elif="{{!list.length && !error}}" class="card">暂无符合条件的商家</view>
<button wx:if="{{hasMore && !error}}" bindtap="loadMore" disabled="{{loading || busy || !ready}}">加载更多商家</button>
<view wx:if="{{selected}}" class="card">
<view class="section-title">服务审核：{{selected.name}}</view>
<view wx:if="{{servicesError}}" class="error">{{servicesError}}<button bindtap="retryServices" disabled="{{servicesLoading || busy}}">重试读取服务</button></view>
<view wx:if="{{servicesLoading}}">正在加载服务…</view>
<view wx:elif="{{!servicesError && !services.length}}">暂无服务</view>
<view wx:for="{{services}}" wx:key="_id" class="service">
<view>{{item.title}} · <text wx:if="{{item.priceType === 'fixed'}}">固定价：¥{{item.priceText}} / {{item.unit || '次'}}</text>
<text wx:else>预约后报价</text> · {{item.status === 'on' ? '已上架' : (item.status === 'off' ? '已下架' : '状态待确认')}}</view>
<button wx:if="{{selected.status === 'approved' && item.status === 'off'}}" size="mini" data-id="{{item._id}}" data-status="on" bindtap="serviceStatus" disabled="{{busy || loading || servicesLoading || !ready || !servicesReady}}">上架</button>
<button wx:elif="{{selected.status === 'approved'}}" size="mini" data-id="{{item._id}}" data-status="off" bindtap="serviceStatus" disabled="{{busy || loading || servicesLoading || !ready || !servicesReady}}">下架</button>
</view>
<button wx:if="{{servicesHasMore && !servicesError}}" bindtap="loadMoreServices" disabled="{{servicesLoading || busy}}">加载更多服务</button>
<button wx:if="{{selected.status === 'pending'}}" type="primary" data-approved="true" bindtap="review" disabled="{{busy || loading || servicesLoading || !ready}}">通过入驻</button>
<button wx:if="{{selected.status === 'pending'}}" data-approved="false" bindtap="review" disabled="{{busy || loading || servicesLoading || !ready}}">拒绝申请</button>
</view>
</view>
