<view wx:if="{{missingRecord}}" class="page"><view class="card"><view class="section-title">缺少订单编号</view><view class="muted">请从订单管理选择记录后重新进入。</view><navigator url="/admin/orders/orders" open-type="redirect"><button class="ui-button">前往订单管理</button></navigator></view></view>
<block wx:else>
<view class="page"><empty-state wx:if="{{loading}}" message="正在加载…"/><empty-state wx:if="{{error}}" message="{{error}}" retry bind:retry="load"/><block wx:if="{{order}}"><view class="card"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/admin.png"/><view class="masthead-copy"><view class="page-title">{{order.serviceName}} · {{order.statusText}}</view><view class="masthead-subtitle">社区运营 · 按权限管理</view></view></view><view>{{order.orderNo}}</view><view>订单金额 <text wx:if="{{order.status === 'pending_quote'}}">{{amount}}</text><text wx:else>¥{{amount}}</text></view><view>支付记录：{{paymentRecordText}}</view><view>{{order.address.buildingName}} {{order.address.unit}} {{order.address.room}}</view><view>{{slotText}}</view><view>住户电话：{{order.userPhone}}</view><view>备注：{{order.note || '无'}}</view><view wx:for="{{details}}" wx:key="key">{{item.label}}：{{item.value}}</view></view><view class="card" wx:if="{{order.visitReport}}"><view class="section-title">探访报告</view><view wx:if="{{order.visitReport.attention}}" class="error">需关注：服务员已确认电话通知住户</view><view wx:if="{{order.visitReport.notes}}">补充说明：{{order.visitReport.notes}}</view><view>提交时间：{{order.visitReport.attentionNotifiedAt || order.deliveredAt}}</view></view><view class="card" wx:if="{{order.photos.length}}"><view class="section-title">完成照片</view><private-media media-class="photo" wx:for="{{order.photos}}" wx:key="*this" src="{{item}}" data-url="{{item}}" bindtap="preview"/><private-media wx:if="{{order.receiptPhoto}}" media-class="photo" src="{{order.receiptPhoto}}" data-url="{{order.receiptPhoto}}" bindtap="preview"/></view><button class="ui-button" wx:if="{{!readOnly && order.status === 'disputed'}}" bindtap="openChat">查看投诉相关聊天记录（记录审计日志）</button><view class="card" wx:if="{{order.complaint}}"><view class="section-title">投诉信息</view><view>{{order.complaint.reason}}</view><view>{{order.complaint.text}}</view><view wx:if="{{order.complaint.resolution}}">处理说明：{{order.complaint.resolution.note}}</view></view><view class="card" wx:if="{{refunds.length}}"><view class="section-title">退款记录</view><view wx:for="{{refunds}}" wx:key="index"><view>¥{{item.amountText}} · {{item.statusText}}</view><view>{{item.reason}}</view><button class="ui-button" wx:if="{{!readOnly && item.status === 'failed'}}" data-no="{{item.outRefundNo}}" bindtap="retryRefund" disabled="{{busy}}">重试退款</button></view></view><view class="card" wx:if="{{!readOnly && order.status === 'paid'}}"><view class="section-title">指派服务员</view><picker range="{{providers}}" range-key="realName" value="{{providerIndex}}" bindchange="provider"><view class="picker">{{providers[providerIndex].realName || '请选择服务员'}}</view></picker><button class="ui-button" type="primary" bindtap="assign" disabled="{{busy || !providers.length}}">确认指派</button></view><button class="ui-button" wx:if="{{!readOnly && canCancel}}" bindtap="cancel" disabled="{{busy}}">强制取消并退款</button><view class="card" wx:if="{{!readOnly && order.status === 'disputed'}}"><view class="section-title">处理投诉</view><view>服务费退款（元）</view><input type="digit" value="{{serviceRefundYuan}}" data-field="serviceRefundYuan" bindinput="resolutionField"/><block wx:if="{{order.serviceCode === 'buy'}}"><view>商品款退款（元）</view><input type="digit" value="{{goodsRefundYuan}}" data-field="goodsRefundYuan" bindinput="resolutionField"/></block><view>退款合计 ¥{{refundTotal}}</view><checkbox-group bindchange="liable"><label><checkbox value="liable" checked="{{providerLiable}}"/>服务员有责</label></checkbox-group><textarea value="{{resolutionNote}}" data-field="resolutionNote" bindinput="resolutionField" maxlength="500" placeholder="请填写处理说明"/><button class="ui-button" type="primary" bindtap="resolve" disabled="{{busy}}">提交处理结果</button></view><view class="card" wx:if="{{!readOnly && order.kind === 'membership_purchase' && order.status === 'paid'}}"><view class="section-title">作废月卡</view><view>本购买订单退款（元）</view><input type="digit" value="{{voidRefundYuan}}" data-field="voidRefundYuan" bindinput="resolutionField"/><textarea value="{{voidNote}}" data-field="voidNote" bindinput="resolutionField" maxlength="200" placeholder="作废说明"/><button class="ui-button" bindtap="voidCard" disabled="{{busy}}">作废月卡并按金额退款</button></view><button class="ui-button" bindtap="load">刷新订单</button></block></view>

</block>
