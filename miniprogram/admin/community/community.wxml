<view class="page"><view class="page-masthead"><image class="masthead-icon" src="/assets/icons/admin.png"/><view class="masthead-copy"><view class="page-title">小区与运营配置</view><view class="masthead-subtitle">按真实资料维护，保存后影响新订单</view></view></view>
<view wx:if="{{refreshError}}" class="error">{{refreshError}}<button bindtap="retrySavedRefresh" disabled="{{saving}}" loading="{{saving}}">重试刷新（不重复保存）</button></view><view wx:if="{{loading}}" class="card">正在加载…</view><view wx:if="{{error}}" class="error">{{error}}<button wx:if="{{canReload}}" bindtap="load" disabled="{{saving}}">重新加载</button></view>
<block wx:if="{{authorized && !loading && community}}"><picker disabled="{{saving}}" range="{{communities}}" range-key="name" value="{{communityIndex}}" bindchange="chooseCommunity"><view class="picker">{{community.name}}</view></picker>
<view class="card"><view class="section-title">小区资料</view><view class="field"><text class="label">名称</text><input type="text" value="{{name}}" data-field="name" bindinput="input"/></view><view class="field"><text class="label">城市</text><input type="text" value="{{city}}" data-field="city" bindinput="input"/></view><view class="field"><text class="label">区县</text><input type="text" value="{{district}}" data-field="district" bindinput="input"/></view><view class="field"><text class="label">公开地址</text><input type="text" value="{{address}}" data-field="address" bindinput="input"/></view><view class="field"><text class="label">物业名称</text><input type="text" value="{{propertyName}}" data-field="propertyName" bindinput="input"/></view><view class="field"><text class="label">联合社区组（留空不加入）</text><input type="text" value="{{federationGroupId}}" data-field="federationGroupId" bindinput="input"/></view><view class="field"><text class="label">地图位置</text><view>{{locationText}}</view><button bindtap="chooseLocation">地图选点</button></view></view>
<view wx:if="{{buildingRecoveryHint}}" class="notice">{{buildingRecoveryHint}}<button wx:if="{{buildingRecovery === 'lookup'}}" bindtap="checkOriginalBuilding">重试核对原楼栋</button></view><view class="card"><view class="section-title">楼栋与单元</view><view class="muted">管理员手填维护，住户从列表选择。楼栋独立保存，不提交其他配置。</view><view wx:if="{{!community.buildings.length}}" class="muted">尚未配置楼栋</view><view wx:for="{{community.buildings}}" wx:key="_id" class="menu-row"><text class="menu-copy">{{item.name}}</text><button size="mini" data-id="{{item._id}}" bindtap="editBuilding" disabled="{{saving}}">编辑</button></view><view class="field"><text class="label">楼栋名称</text><input type="text" value="{{buildingName}}" data-field="buildingName" bindinput="input"/></view><view class="field"><text class="label">单元（用逗号分隔）</text><input type="text" value="{{buildingUnits}}" data-field="buildingUnits" bindinput="input"/></view><view class="actions"><button bindtap="newBuilding" disabled="{{saving}}">填写新楼栋</button><button type="primary" bindtap="addBuilding" disabled="{{saving || refreshCommunityId}}" loading="{{saving}}">{{buildingId ? '保存楼栋修改' : '新增楼栋'}}</button></view></view><view class="card"><view class="section-title">驿站</view><view wx:for="{{stations}}" wx:key="index" class="config-row"><view class="field"><text class="label">站点代码</text><input type="text" value="{{item.code}}" data-list="stations" data-index="{{index}}" data-field="code" bindinput="rowInput"/></view><view class="field"><text class="label">站点名称</text><input type="text" value="{{item.name}}" data-list="stations" data-index="{{index}}" data-field="name" bindinput="rowInput"/></view><button class="ui-button" data-list="stations" data-index="{{index}}" bindtap="removeRow" disabled="{{saving}}">移除此行</button></view><button class="ui-button" data-list="stations" bindtap="addRow" disabled="{{saving}}">新增驿站</button></view><view class="card"><view class="section-title">值班时段</view><view wx:for="{{dutyWindows}}" wx:key="index" class="config-row"><view class="field"><text class="label">开始时间（HH:mm）</text><input type="text" value="{{item.start}}" data-list="dutyWindows" data-index="{{index}}" data-field="start" bindinput="rowInput"/></view><view class="field"><text class="label">结束时间（HH:mm，可跨午夜）</text><input type="text" value="{{item.end}}" data-list="dutyWindows" data-index="{{index}}" data-field="end" bindinput="rowInput"/></view><button class="ui-button" data-list="dutyWindows" data-index="{{index}}" bindtap="removeRow" disabled="{{saving}}">移除此行</button></view><button class="ui-button" data-list="dutyWindows" bindtap="addRow" disabled="{{saving}}">新增值班时段</button></view><view class="card"><view class="section-title">合作食堂</view><view wx:for="{{canteens}}" wx:key="index" class="config-row"><view class="field"><text class="label">食堂代码</text><input type="text" value="{{item.code}}" data-list="canteens" data-index="{{index}}" data-field="code" bindinput="rowInput"/></view><view class="field"><text class="label">食堂名称</text><input type="text" value="{{item.name}}" data-list="canteens" data-index="{{index}}" data-field="name" bindinput="rowInput"/></view><view class="field"><text class="label">关联商家编号（可选）</text><input type="text" value="{{item.merchantId}}" data-list="canteens" data-index="{{index}}" data-field="merchantId" bindinput="rowInput"/></view><button class="ui-button" data-list="canteens" data-index="{{index}}" bindtap="removeRow" disabled="{{saving}}">移除此行</button></view><button class="ui-button" data-list="canteens" bindtap="addRow" disabled="{{saving}}">新增合作食堂</button></view><view class="card"><view class="section-title">服务分成</view><view class="muted">小数费率，例如0.2表示20%；平台与物业合计不得超过1。</view><view class="field"><text class="label">平台费率</text><input type="digit" value="{{platformRate}}" data-field="platformRate" bindinput="input"/></view><view class="field"><text class="label">物业费率</text><input type="digit" value="{{propertyRate}}" data-field="propertyRate" bindinput="input"/></view></view><view class="card"><view class="section-title">服务价格与数量</view><view class="muted">金额单位为分；未配置项留空，不自动填写商业价格。已配置项留空保留原值。</view><view class="field"><text class="label">帮把手计价方式</text><picker range="{{helpModes}}" value="{{helpModeIndex}}" bindchange="chooseHelpMode" disabled="{{saving}}"><view class="picker">{{helpModes[helpModeIndex]}}</view></picker></view><view class="field" wx:for="{{priceRows}}" wx:key="key" wx:if="{{helpModeIndex === 1 ? item.key !== 'help.per15min' && item.key !== 'help.maxBlocks' : item.key !== 'help.perVisit' && item.key !== 'help.includedMinutes'}}"><text class="label">{{item.label}}</text><input type="number" value="{{item.value}}" data-list="priceRows" data-index="{{index}}" data-field="value" bindinput="rowInput"/></view><view class="field"><text class="label">喂宠节假日（每行 YYYY-MM-DD）</text><textarea class="ui-textarea" value="{{holidayDates}}" data-field="holidayDates" bindinput="input"/></view><view class="field"><text class="label">喂宠需宠物照护证书</text><switch checked="{{petCertRequired}}" bindchange="togglePetCert"/></view></view>
<view class="card"><view class="section-title">回收分类</view><view class="muted">启用品类须同时填写积分、企业收购价与已审核回收企业编号；全部留空保留原值。</view><view class="config-row" wx:for="{{recycleRows}}" wx:key="key"><view>{{item.label}}</view><view class="field"><text class="label">每公斤积分</text><input type="number" value="{{item.pointsPerKg}}" data-list="recycleRows" data-index="{{index}}" data-field="pointsPerKg" bindinput="rowInput"/></view><view class="field"><text class="label">每公斤企业收购价（分）</text><input type="number" value="{{item.purchaseFenPerKg}}" data-list="recycleRows" data-index="{{index}}" data-field="purchaseFenPerKg" bindinput="rowInput"/></view><view class="field"><text class="label">回收企业编号</text><input type="text" value="{{item.recyclerId}}" data-list="recycleRows" data-index="{{index}}" data-field="recyclerId" bindinput="rowInput"/></view></view></view><view class="card"><view class="section-title">月卡计划</view><view class="muted">金额单位为分。有有效月卡或待付款月卡订单时，不可移除计划或修改排期、额度、有效天数；新购价格可调整。</view><view wx:for="{{plans}}" wx:key="index" class="config-row"><picker range="{{planOptions}}" range-key="name" value="{{item.kindIndex}}" data-index="{{index}}" bindchange="choosePlan"><view class="picker">{{planOptions[item.kindIndex].name}}</view></picker><view class="field"><text class="label">月卡名称</text><input type="text" value="{{item.name}}" data-list="plans" data-index="{{index}}" data-field="name" bindinput="rowInput"/></view><view class="field"><text class="label">常规价格（分）</text><input type="number" value="{{item.price}}" data-list="plans" data-index="{{index}}" data-field="price" bindinput="rowInput"/></view><view class="field"><text class="label">首期价格（分）</text><input type="number" value="{{item.firstPeriodPrice}}" data-list="plans" data-index="{{index}}" data-field="firstPeriodPrice" bindinput="rowInput"/></view><view class="field"><text class="label">有效天数（巡检固定30天）</text><input type="number" value="{{item.days}}" data-list="plans" data-index="{{index}}" data-field="days" bindinput="rowInput"/></view><block wx:if="{{item.kindIndex === 1}}"><view class="field"><text class="label">每日免费件数</text><input type="number" value="{{item.dailyParcelQuota}}" data-list="plans" data-index="{{index}}" data-field="dailyParcelQuota" bindinput="rowInput"/></view></block><block wx:if="{{item.kindIndex === 2}}"><view class="field"><text class="label">每周日期（1至7，逗号分隔）</text><input type="text" value="{{item.weekdays}}" data-list="plans" data-index="{{index}}" data-field="weekdays" bindinput="rowInput"/></view></block><view wx:if="{{item.kindIndex === 3}}" class="muted">每月1日、15日排期</view><button data-list="plans" data-index="{{index}}" bindtap="removeRow" disabled="{{saving}}">移除此月卡计划</button></view><button data-list="plans" bindtap="addRow" disabled="{{saving}}">新增月卡计划</button></view><button type="primary" bindtap="saveCommunity" disabled="{{saving || refreshCommunityId}}" loading="{{saving}}">保存小区运营配置</button></block><block wx:if="{{!loading && globalRows.length}}"><view class="card"><view class="section-title">全局运营配置</view><view class="muted">适用于所有小区，与小区配置分别保存。</view><view class="field"><text class="label">客服电话（留空关闭）</text><input type="text" value="{{hotline}}" data-field="hotline" bindinput="input"/></view><view wx:for="{{globalRows}}" wx:key="key" class="field"><text class="label">{{item.label}}</text><input type="number" value="{{item.value}}" data-list="globalRows" data-index="{{index}}" data-field="value" bindinput="rowInput"/></view><view wx:for="{{keywordRows}}" wx:key="key" class="field"><text class="label">{{item.label}}（每行一项）</text><textarea class="ui-textarea" value="{{item.value}}" data-list="keywordRows" data-index="{{index}}" data-field="value" bindinput="rowInput"/></view><button type="primary" bindtap="saveGlobal" disabled="{{saving || refreshCommunityId}}" loading="{{saving}}">保存全局运营配置</button></view></block></view>