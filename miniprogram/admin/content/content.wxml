<view class="page">
  <view class="page-masthead"><image class="masthead-icon" src="/assets/icons/admin.png"/><view class="masthead-copy"><view class="page-title">公告与广告管理</view><view class="masthead-subtitle">社区运营 · 按权限管理</view></view></view>
  <view wx:if="{{loading}}">正在加载…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view>
  <view wx:if="{{authorized}}" class="card">
    <picker wx:if="{{isAdmin}}" range="{{communities}}" range-key="name" value="{{communityIndex}}" bindchange="chooseCommunity" disabled="{{loading || saving}}"><view class="picker">管理及投放小区：{{communities[communityIndex].name || '请选择小区'}}</view></picker>
    <view wx:else>物业管理小区：{{communities[communityIndex].name || '尚未分配'}}</view>
    <view wx:if="{{noticeError}}" class="error">{{noticeError}}<button bindtap="load">重新加载小区与公告</button></view>
  </view>
  <view wx:if="{{authorized && communityId}}" class="card">
    <view class="section-title">发布本小区公告</view>
    <view class="field"><view class="label">公告标题</view><input class="ui-input" placeholder="标题" data-field="title" value="{{title}}" bindinput="input" /></view>
    <view class="field"><view class="label">公告正文</view><textarea class="ui-textarea" placeholder="公告正文" data-field="body" value="{{body}}" bindinput="input" /></view>
    <button size="mini" data-field="imageFileId" bindtap="chooseImage">选择公告图片（选填）</button><view wx:if="{{imageFileId}}" class="muted">已上传，发布后异步审核</view>
    <picker mode="date" data-field="endAt" bindchange="input"><view class="picker">有效期至：{{endAt || '请选择日期'}}</view></picker>
    <view class="row"><text>置顶</text><switch checked="{{pinned}}" bindchange="togglePinned" /></view>
    <button loading="{{saving}}" disabled="{{saving || loading || !noticeReady}}" bindtap="saveNotice">发布公告</button>
  </view>
  <view wx:if="{{authorized && communityId}}" class="card">
    <view class="section-title">当前公告</view>
    <view wx:for="{{notices}}" wx:key="_id" class="row"><text>{{item.title}}</text><button size="mini" disabled="{{saving || !noticeReady}}" data-id="{{item._id}}" bindtap="endNotice">结束</button></view>
  </view>
  <view wx:if="{{isAdmin}}" class="card">
    <view wx:if="{{adError}}" class="error">{{adError}}<button bindtap="loadAds">重新加载广告</button></view>
    <view class="section-title">录入首页广告</view>
    <view>广告标题</view>
    <input class="ui-input" placeholder="广告标题" data-field="adTitle" value="{{adTitle}}" bindinput="input" />
    <button size="mini" data-field="adImage" bindtap="chooseImage">选择广告图片</button><view wx:if="{{adImage}}" class="muted">已上传，审核通过后展示</view>
    <picker range="{{adSlotLabels}}" value="{{adSlotIndex}}" bindchange="adSlotChange"><view class="picker">广告位：{{adSlotLabels[adSlotIndex]}}</view></picker>
    <picker range="{{adTargetTypeLabels}}" value="{{adTargetTypeIndex}}" bindchange="adTargetTypeChange"><view class="picker">目标类型：{{adTargetTypeLabels[adTargetTypeIndex]}}</view></picker>
    <view wx:if="{{adTargetType !== 'page'}}">{{adTargetType === 'merchant' ? '商家编号' : '活动编号'}}</view>
    <input class="ui-input" wx:if="{{adTargetType !== 'page'}}" placeholder="请输入对应编号" data-field="adTargetId" value="{{adTargetId}}" bindinput="input" />
    <picker wx:if="{{adTargetType === 'page'}}" range="{{adPathLabels}}" value="{{adPathIndex}}" bindchange="adPathChange"><view class="picker">小程序页面：{{adPathLabels[adPathIndex]}}</view></picker>
    <picker mode="date" data-field="adStart" bindchange="input"><view class="picker">开始日期：{{adStart || '请选择'}}</view></picker>
    <picker mode="date" data-field="adEnd" bindchange="input"><view class="picker">结束日期：{{adEnd || '请选择'}}</view></picker>
    <view>广告金额（元）</view>
    <view class="muted">最多两位小数；保存或上线不记收入，确认已收款后才记账。</view>
    <input class="ui-input" type="digit" placeholder="广告金额（元）" data-field="adPrice" value="{{adPrice}}" bindinput="input" />
    <picker range="{{adStatusLabels}}" value="{{adStatusIndex}}" bindchange="adStatusChange"><view class="picker">状态：{{adStatusLabels[adStatusIndex]}}</view></picker>
    <button loading="{{saving}}" disabled="{{saving || loading || !communityId || !adReady}}" bindtap="saveAd">保存广告</button>
    <view wx:for="{{ads}}" wx:key="_id" class="row">{{item.title}} · {{adStatusNames[item.status] || '未知状态'}} · ¥{{item.priceYuan}} · {{item.paymentReceivedAt ? '已确认收款' : '未确认收款'}}<button wx:if="{{!item.paymentReceivedAt && item.price > 0}}" size="mini" disabled="{{saving || !adReady}}" data-id="{{item._id}}" bindtap="confirmAdReceived">确认已收款</button><button wx:if="{{item.status === 'live'}}" size="mini" disabled="{{saving || !adReady}}" data-id="{{item._id}}" bindtap="endAd">结束</button></view>
  </view>
</view>
